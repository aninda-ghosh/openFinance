{
  "description": "The dashboard read after writes through other domains: investments (linked/unlinked, vehicles with and without depreciation, a future purchase), value changes and a price refresh, policies (upcoming premiums, payouts inside/outside 90 days, received, unlinking and re-linking accounts, delete), a life-insurance entry, and base-currency changes (INR, EUR, back to USD).",
  "steps": [
    {
      "name": "baseline: dashboard",
      "method": "GET",
      "path": "/api/dashboard?month=2026-11"
    },
    {
      "name": "baseline: net worth",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "baseline: cash flow",
      "method": "GET",
      "path": "/api/dashboard/cash-flow?month=2026-11"
    },
    {
      "name": "baseline: net worth history",
      "method": "GET",
      "path": "/api/dashboard/net-worth-history?months=8"
    },
    {
      "name": "baseline: portfolio breakdown",
      "method": "GET",
      "path": "/api/dashboard/portfolio-breakdown"
    },
    {
      "name": "baseline: top movers",
      "method": "GET",
      "path": "/api/dashboard/top-movers?limit=10"
