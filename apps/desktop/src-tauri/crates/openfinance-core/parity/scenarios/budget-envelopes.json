{
  "description": "routes/budget.ts envelopes and envelope groups: month listing (seeding new months, rollover), create / update / delete / reclaim, copy-previous and clear-budget, group CRUD, the summary and trends reports, and the static paths that fall through to /envelopes/:id.",
  "steps": [
    { "name": "list May", "method": "GET", "path": "/api/budget/envelopes?month=2026-05" },
    { "name": "list: missing month", "method": "GET", "path": "/api/budget/envelopes" },
    { "name": "list: bad month", "method": "GET", "path": "/api/budget/envelopes?month=2026-13" },
    { "name": "list: day included", "method": "GET", "path": "/api/budget/envelopes?month=2026-05-01" },
    { "name": "list: first month param wins", "method": "GET", "path": "/api/budget/envelopes?month=2026-06&month=bad" },
    { "name": "list: encoded month", "method": "GET", "path": "/api/budget/envelopes?month=2026%2D07" },
    { "name": "list April (earliest)", "method": "GET", "path": "/api/budget/envelopes?month=2026-04" },
    { "name": "list a month before any budget (empty, seeds from latest)", "method": "GET", "path": "/api/budget/envelopes?month=2026-02" },
    { "name": "list a future month (seeds from July)", "method": "GET", "path": "/api/budget/envelopes?month=2026-09" },
    { "name": "summary of seeded month", "method": "GET", "path": "/api/budget/reports/summary?month=2026-09" },
    { "name": "summary May", "method": "GET", "path": "/api/budget/reports/summary?month=2026-05" },
    { "name": "summary June", "method": "GET", "path": "/api/budget/reports/summary?month=2026-06" },
    { "name": "summary: bad month", "method": "GET", "path": "/api/budget/reports/summary?month=May" },
    { "name": "summary: no month", "method": "GET", "path": "/api/budget/reports/summary" },

    { "name": "trends default", "method": "GET", "path": "/api/budget/reports/envelope-trends/env-2026-05-13" },
    { "name": "trends 2 months", "method": "GET", "path": "/api/budget/reports/envelope-trends/env-2026-05-13?months=2" },
    { "name": "trends 0 months", "method": "GET", "path": "/api/budget/reports/envelope-trends/env-2026-05-13?months=0" },
    { "name": "trends NaN months", "method": "GET", "path": "/api/budget/reports/envelope-trends/env-2026-05-13?months=abc" },
    { "name": "trends negative months", "method": "GET", "path": "/api/budget/reports/envelope-trends/env-2026-05-12?months=-1" },
    { "name": "trends empty months", "method": "GET", "path": "/api/budget/reports/envelope-trends/env-2026-05-12?months=" },
    { "name": "trends fractional months", "method": "GET", "path": "/api/budget/reports/envelope-trends/env-2026-05-12?months=2.5" },
    { "name": "trends unknown envelope", "method": "GET", "path": "/api/budget/reports/envelope-trends/nope" },

    { "name": "create: validation", "method": "POST", "path": "/api/budget/envelopes", "json": { "group_id": "", "name": "X", "month": "2026-5" } },
    { "name": "create: negative budget", "method": "POST", "path": "/api/budget/envelopes", "json": { "group_id": "group-needs", "name": "X", "month": "2026-05", "budgeted": -1 } },
    { "name": "create: bad rollover", "method": "POST", "path": "/api/budget/envelopes", "json": { "group_id": "group-needs", "name": "X", "month": "2026-05", "rollover_type": "all" } },
    { "name": "create: invalid JSON", "method": "POST", "path": "/api/budget/envelopes", "body": "[" },
    { "name": "create: unknown group (FK)", "method": "POST", "path": "/api/budget/envelopes", "json": { "group_id": "nope", "name": "X", "month": "2026-05" } },
    { "name": "create Gifts in May (USD)", "method": "POST", "path": "/api/budget/envelopes", "json": { "group_id": "group-wants", "name": "Gifts", "month": "2026-05", "budgeted": 80.5, "budget_currency": "USD" }, "capture": { "gifts": "id" } },
    { "name": "create Savings Jar in June with rollover", "method": "POST", "path": "/api/budget/envelopes", "json": { "group_id": "group-savings", "name": "Jar", "month": "2026-06", "budgeted": 1000, "rollover_type": "amount", "rollover_amount": 500 }, "capture": { "jar": "id" } },
    { "name": "create Gifts in June with leftover rollover", "method": "POST", "path": "/api/budget/envelopes", "json": { "group_id": "group-wants", "name": "Gifts", "month": "2026-06", "budgeted": 10, "budget_currency": "USD", "rollover_type": "leftover" }, "capture": { "giftsJune": "id" } },
    { "name": "June list shows rollover", "method": "GET", "path": "/api/budget/envelopes?month=2026-06" },

    { "name": "update: empty body is a 500", "method": "PATCH", "path": "/api/budget/envelopes/{{gifts}}", "json": {} },
    { "name": "update: unknown fields only is a 500", "method": "PATCH", "path": "/api/budget/envelopes/{{gifts}}", "json": { "month": "2026-01" } },
    { "name": "update: validation", "method": "PATCH", "path": "/api/budget/envelopes/{{gifts}}", "json": { "budgeted": "5" } },
    { "name": "update: unknown envelope", "method": "PATCH", "path": "/api/budget/envelopes/nope", "json": { "budgeted": 5 } },
    { "name": "update Groceries budget", "method": "PATCH", "path": "/api/budget/envelopes/env-2026-05-13", "json": { "budgeted": 400, "rollover_type": "leftover" } },
    { "name": "update Gifts currency", "method": "PATCH", "path": "/api/budget/envelopes/{{gifts}}", "json": { "budget_currency": "EUR", "name": "Presents" } },
    { "name": "June list after updates", "method": "GET", "path": "/api/budget/envelopes?month=2026-06" },

    { "name": "reclaim Groceries surplus", "method": "POST", "path": "/api/budget/envelopes/env-2026-05-13/reclaim" },
    { "name": "reclaim again: nothing left", "method": "POST", "path": "/api/budget/envelopes/env-2026-05-13/reclaim" },
    { "name": "reclaim overspent Rent", "method": "POST", "path": "/api/budget/envelopes/env-2026-05-12/reclaim" },
    { "name": "reclaim June jar with rollover", "method": "POST", "path": "/api/budget/envelopes/{{jar}}/reclaim" },
    { "name": "reclaim unknown", "method": "POST", "path": "/api/budget/envelopes/nope/reclaim" },
    { "name": "reclaim GET is a 404", "method": "GET", "path": "/api/budget/envelopes/env-2026-05-13/reclaim" },
    { "name": "May after reclaims", "method": "GET", "path": "/api/budget/envelopes?month=2026-05" },
    { "name": "June after reclaims", "method": "GET", "path": "/api/budget/envelopes?month=2026-06" },

    { "name": "copy-previous: no month", "method": "POST", "path": "/api/budget/envelopes/copy-previous", "json": {} },
    { "name": "copy-previous: bad month", "method": "POST", "path": "/api/budget/envelopes/copy-previous", "json": { "month": "2026-1" } },
    { "name": "copy-previous: invalid JSON", "method": "POST", "path": "/api/budget/envelopes/copy-previous", "body": "x" },
    { "name": "copy-previous: number month", "method": "POST", "path": "/api/budget/envelopes/copy-previous", "json": { "month": 202606 } },
    { "name": "copy-previous into June", "method": "POST", "path": "/api/budget/envelopes/copy-previous", "json": { "month": "2026-06" } },
    { "name": "June after copy", "method": "GET", "path": "/api/budget/envelopes?month=2026-06" },
    { "name": "copy-previous into an empty future month", "method": "POST", "path": "/api/budget/envelopes/copy-previous", "json": { "month": "2027-01" } },
    { "name": "January 2027", "method": "GET", "path": "/api/budget/envelopes?month=2027-01" },
    { "name": "copy-previous before any budget", "method": "POST", "path": "/api/budget/envelopes/copy-previous", "json": { "month": "2025-01" } },
    { "name": "clear-budget: bad month", "method": "POST", "path": "/api/budget/envelopes/clear-budget", "json": { "month": "" } },
    { "name": "clear-budget July", "method": "POST", "path": "/api/budget/envelopes/clear-budget", "json": { "month": "2026-07" } },
    { "name": "clear-budget empty month", "method": "POST", "path": "/api/budget/envelopes/clear-budget", "json": { "month": "2030-12" } },
    { "name": "July after clear", "method": "GET", "path": "/api/budget/envelopes?month=2026-07" },
    { "name": "PATCH copy-previous falls through to :id", "method": "PATCH", "path": "/api/budget/envelopes/copy-previous", "json": { "budgeted": 1 } },
    { "name": "DELETE clear-budget falls through to :id", "method": "DELETE", "path": "/api/budget/envelopes/clear-budget" },
    { "name": "GET copy-previous is a 404", "method": "GET", "path": "/api/budget/envelopes/copy-previous" },
    { "name": "copy-previous reclaim path", "method": "POST", "path": "/api/budget/envelopes/copy-previous/reclaim" },

    { "name": "delete Presents", "method": "DELETE", "path": "/api/budget/envelopes/{{gifts}}" },
    { "name": "delete Presents again", "method": "DELETE", "path": "/api/budget/envelopes/{{gifts}}" },
    { "name": "delete Groceries May (uncategorises)", "method": "DELETE", "path": "/api/budget/envelopes/env-2026-05-13" },
    { "name": "May transactions after delete", "method": "GET", "path": "/api/budget/transactions?date_from=2026-05-01&date_to=2026-05-31&limit=200" },
    { "name": "May summary after delete", "method": "GET", "path": "/api/budget/reports/summary?month=2026-05" },

    { "name": "groups", "method": "GET", "path": "/api/budget/envelope-groups" },
    { "name": "create group: no name", "method": "POST", "path": "/api/budget/envelope-groups", "json": {} },
    { "name": "create group: blank name", "method": "POST", "path": "/api/budget/envelope-groups", "json": { "name": "   " } },
    { "name": "create group: number name (TypeError)", "method": "POST", "path": "/api/budget/envelope-groups", "json": { "name": 5 } },
    { "name": "create group: null body", "method": "POST", "path": "/api/budget/envelope-groups", "body": "null" },
    { "name": "create group: invalid JSON", "method": "POST", "path": "/api/budget/envelope-groups", "body": "{" },
    { "name": "create group", "method": "POST", "path": "/api/budget/envelope-groups", "json": { "name": "  Travel  ", "sort_order": 99 }, "capture": { "travel": "id" } },
    { "name": "create envelope in new group", "method": "POST", "path": "/api/budget/envelopes", "json": { "group_id": "{{travel}}", "name": "Flights", "month": "2026-05", "budgeted": 200, "budget_currency": "USD" }, "capture": { "flights": "id" } },
    { "name": "rename group: blank", "method": "PATCH", "path": "/api/budget/envelope-groups/{{travel}}", "json": { "name": "" } },
    { "name": "rename group: array name", "method": "PATCH", "path": "/api/budget/envelope-groups/{{travel}}", "json": { "name": ["x"] } },
    { "name": "rename unknown group", "method": "PATCH", "path": "/api/budget/envelope-groups/nope", "json": { "name": "Ghost" } },
    { "name": "rename group", "method": "PATCH", "path": "/api/budget/envelope-groups/{{travel}}", "json": { "name": "Trips" } },
    { "name": "groups after create", "method": "GET", "path": "/api/budget/envelope-groups" },
    { "name": "May with new group", "method": "GET", "path": "/api/budget/envelopes?month=2026-05" },
    { "name": "delete group", "method": "DELETE", "path": "/api/budget/envelope-groups/{{travel}}" },
    { "name": "delete group again", "method": "DELETE", "path": "/api/budget/envelope-groups/{{travel}}" },
    { "name": "delete seeded group with transactions", "method": "DELETE", "path": "/api/budget/envelope-groups/group-wants" },
    { "name": "groups after delete", "method": "GET", "path": "/api/budget/envelope-groups" },
    { "name": "May after group delete", "method": "GET", "path": "/api/budget/envelopes?month=2026-05" },
    { "name": "summary May after group delete", "method": "GET", "path": "/api/budget/reports/summary?month=2026-05" }
  ]
}
