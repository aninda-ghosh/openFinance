{
  "description": "Investment documents (routes/investments.ts /:id/documents and /documents/:docId) on documents restored from a backup ZIP with fixed disk names: list, download, delete, cascade on investment delete, Hono's route overlaps (/documents/documents lists the documents of investment \"documents\"; DELETE /documents/documents deletes document \"documents\"), and every upload rejection. A successful upload is not compared (its disk name doc_<nanoid(12)><ext> is random, see STATUS.md); it is covered by the Rust route test in http/routes/investments.rs. Also: imported holdings (an orphaned vehicle linked to the generated brokerage, a linked vehicle) in the list and portfolio summary.",
  "steps": [
    {
      "name": "import fixture backup",
      "method": "POST",
      "path": "/api/backup/import",
      "bodyBase64": ""
    },
    {
      "name": "list after import",
      "method": "GET",
      "path": "/api/investments"
    },
    {
      "name": "summary after import (vehicle in a linked account)",
      "method": "GET",
      "path": "/api/investments/portfolio-summary"
    },
    {
      "name": "inv-a value history (null contribution)",
      "method": "GET",
      "path": "/api/investments/inv-a/value-history"
    },
    {
      "name": "inv-a price history",
      "method": "GET",
      "path": "/api/investments/inv-a/price-history"
    },
    {
      "name": "inv-a price history window",
      "method": "GET",
      "path": "/api/investments/inv-a/price-history?from=2025-01-01T00:00:00.001Z&to=2026-01-01T00:00:00.000Z"
    },
    {
      "name": "inv-a documents",
      "method": "GET",
      "path": "/api/investments/inv-a/documents"
    },
    {
      "name": "documents of investment 'documents' (route overlap)",
      "method": "GET",
      "path": "/api/investments/documents/documents"
    },
    {
      "name": "documents of encoded id",
      "method": "GET",
      "path": "/api/investments/%64ocuments/documents"
    },
    {
      "name": "unknown investment documents",
      "method": "GET",
      "path": "/api/investments/nope/documents"
    },
    {
      "name": "download pdf",
      "method": "GET",
      "path": "/api/investments/documents/doc-a1"
    },
    {
      "name": "download txt",
      "method": "GET",
      "path": "/api/investments/documents/doc-a2"
    },
    {
      "name": "download png via encoded id",
      "method": "GET",
      "path": "/api/investments/documents/doc%2Da1"
    },
    {
      "name": "download account doc through investments route",
      "method": "GET",
      "path": "/api/investments/documents/doc-acc"
    },
    {
      "name": "download missing file",
      "method": "GET",
      "path": "/api/investments/documents/doc-gone"
    },
    {
      "name": "download unknown",
      "method": "GET",
      "path": "/api/investments/documents/nope"
    },
    {
      "name": "download bad escape",
      "method": "GET",
      "path": "/api/investments/documents/%E2%zz"
    },
    {
      "name": "HEAD download",
      "method": "HEAD",
      "path": "/api/investments/documents/doc-a2"
    },
    {
      "name": "PUT download path",
      "method": "PUT",
      "path": "/api/investments/documents/doc-a2"
    },
    {
      "name": "POST /documents/:docId is not a route",
      "method": "POST",
      "path": "/api/investments/documents/doc-a1",
      "json": {}
    },
    {
      "name": "upload: no body",
      "method": "POST",
      "path": "/api/investments/inv-a/documents"
    },
    {
      "name": "upload: JSON body",
      "method": "POST",
      "path": "/api/investments/inv-a/documents",
      "json": {
        "file": "x"
      }
    },
    {
      "name": "upload: urlencoded",
      "method": "POST",
      "path": "/api/investments/inv-a/documents",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "body": "file=abc"
    },
    {
      "name": "upload: multipart without file",
      "method": "POST",
      "path": "/api/investments/inv-a/documents",
      "multipart": {
        "fields": {
          "name": "x",
          "notes": "n"
        }
      }
    },
    {
      "name": "upload: file field as text",
      "method": "POST",
      "path": "/api/investments/inv-a/documents",
      "multipart": {
        "fields": {
          "file": "not a file"
        }
      }
    },
    {
      "name": "upload: missing closing boundary",
      "method": "POST",
      "path": "/api/investments/inv-a/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.txt\"\r\n\r\nx\r\n"
    },
    {
      "name": "upload: missing boundary",
      "method": "POST",
      "path": "/api/investments/inv-a/documents",
      "headers": {
        "Content-Type": "multipart/form-data"
      },
      "body": "x"
    },
    {
      "name": "upload to investment 'documents' without a file (route overlap)",
      "method": "POST",
      "path": "/api/investments/documents/documents"
    },
    {
      "name": "documents unchanged",
      "method": "GET",
      "path": "/api/investments/inv-a/documents"
    },
    {
      "name": "delete document doc-a2",
      "method": "DELETE",
      "path": "/api/investments/documents/doc-a2"
    },
    {
      "name": "delete doc-a2 again",
      "method": "DELETE",
      "path": "/api/investments/documents/doc-a2"
    },
    {
      "name": "delete document with missing file",
      "method": "DELETE",
      "path": "/api/investments/documents/doc-gone"
    },
    {
      "name": "DELETE /documents/documents deletes document 'documents'",
      "method": "DELETE",
      "path": "/api/investments/documents/documents"
    },
    {
      "name": "delete unknown document",
      "method": "DELETE",
      "path": "/api/investments/documents/nope"
    },
    {
      "name": "inv-a documents after deletes",
      "method": "GET",
      "path": "/api/investments/inv-a/documents"
    },
    {
      "name": "investment 'documents' documents after delete",
      "method": "GET",
      "path": "/api/investments/documents/documents"
    },
    {
      "name": "all documents",
      "method": "GET",
      "path": "/api/documents"
    },
    {
      "name": "delete investment inv-a (documents cascade)",
      "method": "DELETE",
      "path": "/api/investments/inv-a"
    },
    {
      "name": "inv-a documents after investment delete",
      "method": "GET",
      "path": "/api/investments/inv-a/documents"
    },
    {
      "name": "all documents after cascade",
      "method": "GET",
      "path": "/api/documents"
    },
    {
      "name": "delete investment 'documents'",
      "method": "DELETE",
      "path": "/api/investments/documents"
    },
    {
      "name": "list after deletes",
      "method": "GET",
      "path": "/api/investments"
    },
    {
      "name": "summary after deletes",
      "method": "GET",
      "path": "/api/investments/portfolio-summary"
    },
    {
      "name": "export after deletes",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup"
    },
    {
      "name": "upload to an unknown investment (FK after writing the file)",
      "method": "POST",
      "path": "/api/investments/nope/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF\r\n------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nN\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "no row from the failed upload",
      "method": "GET",
      "path": "/api/documents"
    }
  ]
}
