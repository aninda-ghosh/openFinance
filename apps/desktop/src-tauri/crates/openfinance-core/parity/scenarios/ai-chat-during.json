{
  "description": "Generating flags and SSE behaviour during a stream: a stream held at a gate shows generating with the partial text; attaching replays it (client disconnect after one event, or idle while held); an empty attach message fails validation; POST while generating attaches instead of starting; after release the generation finishes and replays. Also a slow singleton stream followed live by an attached client.",
  "ollama": true,
  "steps": [
    {
      "ollama": {
        "script": [
          {
            "message": {
              "role": "assistant",
              "content": ""
            }
          },
          {
            "stream": [
              {
                "message": {
                  "role": "assistant",
                  "content": "Hel"
                }
              },
              {
                "gate": "g1"
              },
              {
                "message": {
                  "role": "assistant",
                  "content": "lo"
                }
              },
              {
                "done": true
              }
            ]
          }
        ]
      }
    },
    {
      "name": "start",
      "method": "GET",
      "path": "/api/ai/conversations/live/chat?message=hello"
    },
    {
      "name": "generating while held",
      "method": "GET",
      "path": "/api/ai/conversations/live/generating",
      "poll": {
        "until": "state.accumulatedText",
        "equals": "Hel"
      }
    },
    {
      "name": "singleton is not generating",
      "method": "GET",
      "path": "/api/ai/generating"
    },
    {
      "name": "attach mid-stream, disconnect after one event",
      "method": "GET",
      "path": "/api/ai/conversations/live/chat?message=%20",
      "sse": {
        "maxEvents": 1
      }
    },
    {
      "name": "attach mid-stream, wait (idle while held)",
      "method": "GET",
      "path": "/api/ai/conversations/live/chat?message=ignored"
    },
    {
      "name": "attach with empty message is a validation error",
      "method": "GET",
      "path": "/api/ai/conversations/live/chat?message="
    },
    {
      "name": "attach with no message is a validation error too",
      "method": "GET",
      "path": "/api/ai/conversations/live/chat"
    },
    {
      "name": "POST while generating attaches",
      "method": "POST",
      "path": "/api/ai/conversations/live/chat",
      "json": {
        "message": "another"
      },
      "sse": {
        "maxEvents": 1
      }
    },
    {
      "name": "messages so far (user only)",
      "method": "GET",
      "path": "/api/ai/conversations/live/messages"
    },
    {
      "ollama": {
        "release": "g1"
      }
    },
    {
      "name": "done",
      "method": "GET",
      "path": "/api/ai/conversations/live/generating",
      "poll": {
        "until": "state.isDone",
        "equals": true
      }
    },
    {
      "name": "replay",
      "method": "GET",
      "path": "/api/ai/conversations/live/chat?message=%20"
    },
    {
      "name": "messages",
      "method": "GET",
      "path": "/api/ai/conversations/live/messages"
    },
    {
      "name": "requests",
      "ollama": {
        "requests": true,
        "count": 2
      }
    },
    {
      "ollama": {
        "script": [
          {
            "message": {
              "role": "assistant",
              "content": ""
            }
          },
          {
            "stream": [
              {
                "message": {
                  "role": "assistant",
                  "content": "slow "
                }
              },
              {
                "delayMs": 300
              },
              {
                "message": {
                  "role": "assistant",
                  "content": "but "
                }
              },
              {
                "delayMs": 300
              },
              {
                "message": {
                  "role": "assistant",
                  "content": "steady"
                }
              },
              {
                "done": true
              }
            ]
          }
        ]
      }
    },
    {
      "name": "singleton chat (model override)",
      "method": "GET",
      "path": "/api/ai/chat?message=hi&model=other%3A1b"
    },
    {
      "name": "singleton done",
      "method": "GET",
      "path": "/api/ai/generating",
      "poll": {
        "until": "state.isDone",
        "equals": true
      }
    },
    {
      "name": "replay the slow stream",
      "method": "GET",
      "path": "/api/ai/chat"
    },
    {
      "name": "singleton requests",
      "ollama": {
        "requests": true,
        "count": 2
      }
    },
    {
      "name": "memories",
      "memoryFiles": true
    }
  ]
}