    {
      "name": "monthly USD policy starting last month",
      "method": "POST",
      "path": "/api/policies",
      "json": {
        "name": "Saver Plan",
        "provider": "MetLife",
        "currency": "USD",
        "start_date": "2026-10-05",
        "premium_amount": 250,
        "premium_frequency": "monthly",
        "premium_term_years": 5,
        "policy_term_years": 10,
        "maturity_date": "2036-10-05",
        "sum_assured": 50000,
        "maturity_value": 30000
      },
      "capture": {
        "pol": "id",
        "polacc": "account_id"
      }
    },
    {
      "name": "quarterly INR policy starting in a week",
      "method": "POST",
      "path": "/api/policies",
      "json": {
        "name": "Child Plan",
        "provider": "LIC",
        "currency": "INR",
        "start_date": "2026-12-01",
        "premium_amount": 15000,
        "premium_frequency": "quarterly",
        "premium_term_years": 3,
        "policy_term_years": 15,
        "maturity_date": "2041-12-01",
        "sum_assured": 500000,
        "maturity_value": 700000
      },
      "capture": {
        "pol2": "id"
      }
    },
    {
      "name": "payout in five weeks",
      "method": "POST",
      "path": "/api/policies/{{pol}}/payouts",
      "json": {
        "payout_date": "2026-12-30",
        "amount": 1000,
        "label": "Loyalty bonus"
      }
    },
    {
      "name": "payout in two weeks",
      "method": "POST",
      "path": "/api/policies/{{pol}}/payouts",
      "json": {
        "payout_date": "2026-12-08",
        "amount": 500,
        "label": "Cashback"
      }
    },
    {
      "name": "payout already received",
      "method": "POST",
      "path": "/api/policies/{{pol}}/payouts",
      "json": {
        "payout_date": "2026-12-10",
        "amount": 700,
        "label": "Received",
        "is_received": true
      }
    },
    {
      "name": "payout beyond 90 days",
      "method": "POST",
      "path": "/api/policies/{{pol}}/payouts",
      "json": {
        "payout_date": "2030-01-01",
        "amount": 9000,
        "label": "Far"
      }
    },
    {
      "name": "payout in the past",
      "method": "POST",
      "path": "/api/policies/{{pol}}/payouts",
      "json": {
        "payout_date": "2026-01-01",
        "amount": 90,
        "label": "Past"
      }
