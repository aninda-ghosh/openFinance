{
  "description": "routes/backup.ts export → import round trip on each server: the decrypted export ZIP is imported back (plain ZIP path) and exported again; also the import of a ZIP holding documents.",
  "steps": [
    {
      "name": "export seed",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup",
      "captureZip": "seedZip"
    },
    {
      "name": "import documents",
      "method": "POST",
      "path": "/api/backup/import",
      "bodyBase64": ""
    },
    {
      "name": "export with a document",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup",
      "captureZip": "docZip"
    },
    {
      "name": "re-import seed",
      "method": "POST",
      "path": "/api/backup/import",
      "bodyFrom": "seedZip"
    },
    {
      "name": "export after seed re-import (document file stays on disk)",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup"
    },
    {
      "name": "re-import document export",
      "method": "POST",
      "path": "/api/backup/import",
      "bodyFrom": "docZip"
    },
    {
      "name": "export after document re-import",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup"
    },
    {
      "name": "download restored document",
      "method": "GET",
      "path": "/api/documents/d1"
    }
  ]
}
