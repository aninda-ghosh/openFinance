{
  "description": "routes/reset.ts: POST /transactions (deletes transactions and alerts, zeroes envelope budgets) and POST / (wipes all user tables including exchange rates), each read back through a decoded export; also wrong methods and a reset with documents on disk.",
  "steps": [
    {
      "name": "add alerts, documents and AI rows",
      "method": "POST",
      "path": "/api/backup/import",
      "bodyBase64": ""
    },
    {
      "name": "before resets",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup"
    },
    {
      "name": "GET is a 404",
      "method": "GET",
      "path": "/api/reset"
    },
    {
      "name": "GET transactions is a 404",
      "method": "GET",
      "path": "/api/reset/transactions"
    },
    {
      "name": "trailing slash",
      "method": "POST",
      "path": "/api/reset/transactions/"
    },
    {
      "name": "reset transactions",
      "method": "POST",
      "path": "/api/reset/transactions"
    },
    {
      "name": "after transaction reset",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup"
    },
    {
      "name": "reset transactions again",
      "method": "POST",
      "path": "/api/reset/transactions",
      "json": {
        "ignored": true
      }
    },
    {
      "name": "reset all",
      "method": "POST",
      "path": "/api/reset"
    },
    {
      "name": "after full reset (document files stay on disk)",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup"
    },
    {
      "name": "documents after reset",
      "method": "GET",
      "path": "/api/documents"
    },
    {
      "name": "rates after reset",
      "method": "GET",
      "path": "/api/exchange-rates"
    },
    {
      "name": "reset all again",
      "method": "POST",
      "path": "/api/reset"
    },
    {
      "name": "still empty",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup"
    }
  ]
}
