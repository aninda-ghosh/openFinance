        "currency": "USD",
        "purchase_value": 1000,
        "purchase_date": "2026-01-10",
        "current_value": 1300,
        "account_id": "fidelity-brokerage"
      },
      "capture": {
        "msft": "id"
      }
    },
    {
      "name": "unlinked INR mutual fund bought after the history window starts",
      "method": "POST",
      "path": "/api/investments",
      "json": {
        "name": "Index Fund",
        "asset_type": "mutual_fund",
        "currency": "INR",
        "purchase_value": 90000,
        "purchase_date": "2026-09-15",
        "current_value": 81000
      },
      "capture": {
        "mf": "id"
      }
    },
    {
      "name": "vehicle with depreciation",
      "method": "POST",
      "path": "/api/investments",
      "json": {
        "name": "Family Car",
