{
  "description": "routes/backup.ts import: migration pipeline (orphaned investments, policy accounts and premium counts, brokerage renames, rate filtering), JS binding of odd values, documents restored from the ZIP and served by routes/documents.ts; every import is read back through a decoded export.",
  "steps": [
    {
      "name": "seed export",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup"
    },
    {
      "name": "rich import",
      "method": "POST",
      "path": "/api/backup/import",
      "bodyBase64": ""
    },
    {
      "name": "export after rich import",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup"
    },
    {
      "name": "documents list after import",
      "method": "GET",
      "path": "/api/documents"
    },
    {
      "name": "filter by investment",
      "method": "GET",
      "path": "/api/documents?investment_id=inv-ok"
    },
    {
      "name": "filter by account",
      "method": "GET",
      "path": "/api/documents?account_id=acc-b"
    },
    {
      "name": "filter by life insurance",
      "method": "GET",
      "path": "/api/documents?life_insurance_id=li1"
    },
    {
      "name": "filters combine",
      "method": "GET",
      "path": "/api/documents?investment_id=inv-ok&account_id=acc-b"
    },
    {
      "name": "empty filter is ignored",
      "method": "GET",
      "path": "/api/documents?investment_id=&account_id"
    },
    {
      "name": "encoded filter",
      "method": "GET",
      "path": "/api/documents?life_insurance_id=l%69%31"
    },
    {
      "name": "unknown filter value",
      "method": "GET",
      "path": "/api/documents?investment_id=nope"
    },
    {
      "name": "download doc-1",
      "method": "GET",
      "path": "/api/documents/doc-1"
    },
    {
      "name": "download doc-1 via encoded id",
      "method": "GET",
      "path": "/api/documents/doc%2D1"
    },
    {
      "name": "download missing physical file",
      "method": "GET",
      "path": "/api/documents/doc-2"
    },
    {
      "name": "download empty mime",
      "method": "GET",
      "path": "/api/documents/doc-3"
    },
    {
      "name": "download invalid mime header",
      "method": "GET",
      "path": "/api/documents/doc-4"
    },
    {
      "name": "download latin-1 mime",
      "method": "GET",
      "path": "/api/documents/doc-5"
    },
    {
      "name": "download directory path",
      "method": "GET",
      "path": "/api/documents/doc-6"
    },
    {
      "name": "download traversal path",
      "method": "GET",
      "path": "/api/documents/doc-7"
    },
    {
      "name": "download unknown",
      "method": "GET",
      "path": "/api/documents/nope"
    },
    {
      "name": "download bad escape",
      "method": "GET",
      "path": "/api/documents/%E2%zz"
    },
    {
      "name": "HEAD download",
      "method": "HEAD",
      "path": "/api/documents/doc-1"
    },
    {
      "name": "delete doc-1",
      "method": "DELETE",
      "path": "/api/documents/doc-1"
    },
    {
      "name": "delete doc-1 again",
      "method": "DELETE",
      "path": "/api/documents/doc-1"
    },
    {
      "name": "delete doc-2 (no file)",
      "method": "DELETE",
      "path": "/api/documents/doc-2"
    },
    {
      "name": "delete doc-6 (directory)",
      "method": "DELETE",
      "path": "/api/documents/doc-6"
    },
    {
      "name": "documents after deletes",
      "method": "GET",
      "path": "/api/documents"
    },
    {
      "name": "export after deletes",
      "method": "GET",
      "path": "/api/backup/export",
      "decode": "backup"
    },
    {
      "name": "rates after import",
      "method": "GET",
      "path": "/api/exchange-rates"
    }
  ]
}
