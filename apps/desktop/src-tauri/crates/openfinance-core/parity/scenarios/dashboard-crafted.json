{
  "description": "A crafted backup (imported through /api/backup/import) reaching states the validated API cannot: an orphan transfer leg, numeric payees / group names / asset types (JS object key order), a Savings group in another case, an orphan policy account, policies on inactive and shared accounts, an unlinked policy (auto-linked by the import), vehicles with and without a quote date, a zero-value holding, payouts with datetime, legacy and garbage dates, a liability stored positive, an older stale rate row, From Savings and envelope-credit transfers, and a future-dated expense.",
  "steps": [
    {
      "name": "import crafted backup",
      "method": "POST",
      "path": "/api/backup/import",
      "headers": {
        "Content-Type": "application/zip"
      },
      "bodyBase64": ""
    },
    {
      "name": "imported: dashboard November",
      "method": "GET",
      "path": "/api/dashboard?month=2026-11"
    },
    {
      "name": "imported: dashboard October",
      "method": "GET",
      "path": "/api/dashboard?month=2026-10"
    },
    {
      "name": "imported: net worth",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "imported: cash flow November",
      "method": "GET",
      "path": "/api/dashboard/cash-flow?month=2026-11"
    },
    {
      "name": "imported: cash flow October",
      "method": "GET",
      "path": "/api/dashboard/cash-flow?month=2026-10"
    },
    {
      "name": "imported: net worth history",
      "method": "GET",
      "path": "/api/dashboard/net-worth-history?months=12"
    },
    {
      "name": "imported: portfolio breakdown",
      "method": "GET",
      "path": "/api/dashboard/portfolio-breakdown"
    },
    {
      "name": "imported: top movers",
      "method": "GET",
      "path": "/api/dashboard/top-movers?limit=20"
    },
    {
      "name": "imported: spending trends",
      "method": "GET",
      "path": "/api/dashboard/spending-trends?months=3"
    },
    {
      "name": "imported: heatmap",
      "method": "GET",
      "path": "/api/dashboard/budget-heatmap?months=2"
    },
    {
      "name": "reactivate the inactive policy account",
      "method": "PATCH",
      "path": "/api/budget/accounts/polx",
      "json": {
        "is_active": true
      }
    },
    {
      "name": "net worth with the account active again",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "deactivate the linked policy account",
      "method": "PATCH",
      "path": "/api/budget/accounts/polacc",
      "json": {
        "is_active": false
      }
    },
    {
      "name": "net worth: both policies on that account fall back to premiums paid",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "history with policies valued by premiums",
      "method": "GET",
      "path": "/api/dashboard/net-worth-history?months=4"
    },
    {
      "name": "orphan transfer leg removed",
      "method": "DELETE",
      "path": "/api/budget/transactions/t10"
    },
    {
      "name": "cash flow without the orphan leg",
      "method": "GET",
      "path": "/api/dashboard/cash-flow?month=2026-11"
    },
    {
      "name": "net worth history without the orphan leg",
      "method": "GET",
      "path": "/api/dashboard/net-worth-history?months=2"
    }
  ]
}
