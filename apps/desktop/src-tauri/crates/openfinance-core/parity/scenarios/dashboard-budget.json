{
  "description": "The dashboard read after budget writes through the budget routes: expenses in several currencies and envelopes (a Savings group, a numeric group name), income (numeric payee, repeated payee, Starting Balance, off-budget, future-dated), transfers (on/off budget, From Savings, into an envelope, cross-currency), a delete, inactive / off-budget / liability accounts. Every endpoint is re-read after each batch.",
  "steps": [
    {
      "name": "baseline: dashboard",
      "method": "GET",
      "path": "/api/dashboard?month=2026-11"
    },
    {
      "name": "baseline: net worth",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "baseline: cash flow",
      "method": "GET",
      "path": "/api/dashboard/cash-flow?month=2026-11"
    },
    {
      "name": "baseline: net worth history",
      "method": "GET",
      "path": "/api/dashboard/net-worth-history?months=8"
    },
    {
      "name": "baseline: portfolio breakdown",
      "method": "GET",
      "path": "/api/dashboard/portfolio-breakdown"
    },
    {
      "name": "baseline: top movers",
      "method": "GET",
      "path": "/api/dashboard/top-movers?limit=10"
    },
    {
      "name": "baseline: spending trends",
      "method": "GET",
      "path": "/api/dashboard/spending-trends?months=8"
    },
    {
      "name": "baseline: heatmap",
      "method": "GET",
      "path": "/api/dashboard/budget-heatmap?months=2"
    },
    {
      "name": "seed November envelopes",
      "method": "GET",
      "path": "/api/budget/envelopes?month=2026-11",
      "capture": {
        "env1": "envelopes.0.id",
        "env2": "envelopes.3.id"
      }
    },
    {
      "name": "savings-group envelope",
      "method": "POST",
      "path": "/api/budget/envelopes",
      "json": {
        "group_id": "group-savings",
        "name": "Rainy Day",
        "budgeted": 100,
        "budget_currency": "USD",
        "month": "2026-11"
      },
      "capture": {
        "rainy": "id"
      }
    },
    {
      "name": "new group outside the template",
      "method": "POST",
      "path": "/api/budget/envelope-groups",
      "json": {
        "name": "123"
      },
      "capture": {
        "g123": "id"
      }
    },
    {
      "name": "envelope in a numeric-named group",
      "method": "POST",
      "path": "/api/budget/envelopes",
      "json": {
        "group_id": "{{g123}}",
        "name": "7",
        "budgeted": 10,
        "budget_currency": "SGD",
        "month": "2026-11"
      },
      "capture": {
        "env7": "id"
      }
    },
    {
      "name": "expense, USD account",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "chase-checking",
        "envelope_id": "{{env1}}",
        "payee": "Grocer",
        "amount": 82.45,
        "type": "expense",
        "date": "2026-11-10"
      }
    },
    {
      "name": "expense, INR account",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "hdfc-checking-inr",
        "envelope_id": "{{env1}}",
        "payee": "Chai",
        "amount": 1500,
        "type": "expense",
        "date": "2026-11-12"
      }
    },
    {
      "name": "expense, second envelope",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "amex-gold",
        "envelope_id": "{{env2}}",
        "payee": "Cinema",
        "amount": 33.3,
        "type": "expense",
        "date": "2026-11-03"
      }
    },
    {
      "name": "expense into the Savings group",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "chase-checking",
        "envelope_id": "{{rainy}}",
        "payee": "Rainy day",
        "amount": 150,
        "type": "expense",
        "date": "2026-11-05"
      }
    },
    {
      "name": "expense into the numeric group",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "chase-checking",
        "envelope_id": "{{env7}}",
        "payee": "Seven",
        "amount": 7.77,
        "type": "expense",
        "date": "2026-11-06"
      }
    },
    {
      "name": "income, salary",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "chase-checking",
        "payee": "Salary",
        "amount": 5000,
        "type": "income",
        "date": "2026-11-01"
      }
    },
    {
      "name": "income, INR consulting",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "hdfc-checking-inr",
        "payee": "Consulting",
        "amount": 25000,
        "type": "income",
        "date": "2026-11-02"
      }
    },
    {
      "name": "income, numeric payee (sorts first as an object key)",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "chase-checking",
        "payee": "123",
        "amount": 10,
        "type": "income",
        "date": "2026-11-02"
      }
    },
    {
      "name": "income, second salary row (same payee sums)",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "chase-checking",
        "payee": "Salary",
        "amount": 250.5,
        "type": "income",
        "date": "2026-11-15"
      }
    },
    {
      "name": "income, Starting Balance payee (left out of cash flow)",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "chase-checking",
        "payee": "Starting Balance",
        "amount": 99,
        "type": "income",
        "date": "2026-11-02"
      }
    },
    {
      "name": "income, off-budget account (left out of cash flow)",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "ally-hysa",
        "payee": "Interest",
        "amount": 42,
        "type": "income",
        "date": "2026-11-20"
      }
    },
    {
      "name": "income, future-dated (excluded from today's net worth)",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "chase-checking",
        "payee": "Bonus",
        "amount": 2000,
        "type": "income",
        "date": "2027-01-15"
      }
    },
    {
      "name": "income, last month",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "chase-checking",
        "payee": "Salary",
        "amount": 4800,
        "type": "income",
        "date": "2026-10-01"
      }
    },
    {
      "name": "expense, last month",
      "method": "POST",
      "path": "/api/budget/transactions",
      "json": {
        "account_id": "chase-checking",
        "envelope_id": "{{env1}}",
        "payee": "Late grocer",
        "amount": 60,
        "type": "expense",
        "date": "2026-10-20"
      }
    },
    {
      "name": "after transactions: dashboard",
      "method": "GET",
      "path": "/api/dashboard?month=2026-11"
    },
    {
      "name": "after transactions: net worth",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "after transactions: cash flow",
      "method": "GET",
      "path": "/api/dashboard/cash-flow?month=2026-11"
    },
    {
      "name": "after transactions: net worth history",
      "method": "GET",
      "path": "/api/dashboard/net-worth-history?months=8"
    },
    {
      "name": "after transactions: portfolio breakdown",
      "method": "GET",
      "path": "/api/dashboard/portfolio-breakdown"
    },
    {
      "name": "after transactions: top movers",
      "method": "GET",
      "path": "/api/dashboard/top-movers?limit=10"
    },
    {
      "name": "after transactions: spending trends",
      "method": "GET",
      "path": "/api/dashboard/spending-trends?months=8"
    },
    {
      "name": "after transactions: heatmap",
      "method": "GET",
      "path": "/api/dashboard/budget-heatmap?months=2"
    },
    {
      "name": "transfer on-budget to on-budget",
      "method": "POST",
      "path": "/api/budget/transactions/transfer",
      "json": {
        "from_account_id": "chase-checking",
        "to_account_id": "amex-gold",
        "amount": 120,
        "date": "2026-11-16"
      }
    },
    {
      "name": "transfer on-budget to off-budget with an envelope",
      "method": "POST",
      "path": "/api/budget/transactions/transfer",
      "json": {
        "from_account_id": "chase-checking",
        "to_account_id": "ally-hysa",
        "amount": 300,
        "date": "2026-11-17",
        "envelope_id": "{{rainy}}"
      }
    },
    {
      "name": "transfer from savings (funds to_assign)",
      "method": "POST",
      "path": "/api/budget/transactions/transfer",
      "json": {
        "from_account_id": "ally-hysa",
        "to_account_id": "chase-checking",
        "amount": 400,
        "date": "2026-11-18",
        "from_savings": true
      }
    },
    {
      "name": "transfer into an envelope (credit nets the envelope)",
      "method": "POST",
      "path": "/api/budget/transactions/transfer",
      "json": {
        "from_account_id": "ally-hysa",
        "to_account_id": "chase-checking",
        "amount": 50,
        "date": "2026-11-19",
        "to_envelope_id": "{{env1}}"
      }
    },
    {
      "name": "cross-currency transfer",
      "method": "POST",
      "path": "/api/budget/transactions/transfer",
      "json": {
        "from_account_id": "chase-checking",
        "to_account_id": "hdfc-checking-inr",
        "amount": 100,
        "to_amount": 8300,
        "date": "2026-11-21"
      }
    },
    {
      "name": "after transfers: dashboard",
      "method": "GET",
      "path": "/api/dashboard?month=2026-11"
    },
    {
      "name": "after transfers: net worth",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "after transfers: cash flow",
      "method": "GET",
      "path": "/api/dashboard/cash-flow?month=2026-11"
    },
    {
      "name": "after transfers: net worth history",
      "method": "GET",
      "path": "/api/dashboard/net-worth-history?months=8"
    },
    {
      "name": "after transfers: portfolio breakdown",
      "method": "GET",
      "path": "/api/dashboard/portfolio-breakdown"
    },
    {
      "name": "after transfers: top movers",
      "method": "GET",
      "path": "/api/dashboard/top-movers?limit=10"
    },
    {
      "name": "after transfers: spending trends",
      "method": "GET",
      "path": "/api/dashboard/spending-trends?months=8"
    },
    {
      "name": "after transfers: heatmap",
      "method": "GET",
      "path": "/api/dashboard/budget-heatmap?months=2"
    },
    {
      "name": "list November transactions",
      "method": "GET",
      "path": "/api/budget/transactions?date_from=2026-11-01&date_to=2026-11-30&limit=200",
      "capture": {
        "t0": "transactions.0.id"
      }
    },
    {
      "name": "delete a transaction",
      "method": "DELETE",
      "path": "/api/budget/transactions/{{t0}}"
    },
    {
      "name": "dashboard after delete",
      "method": "GET",
      "path": "/api/dashboard?month=2026-11"
    },
    {
      "name": "net worth after delete",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "cash flow after delete",
      "method": "GET",
      "path": "/api/dashboard/cash-flow?month=2026-11"
    },
    {
      "name": "deactivate nothing: create an inactive account",
      "method": "POST",
      "path": "/api/budget/accounts",
      "json": {
        "name": "Old Wallet",
        "type": "cash",
        "currency": "EUR",
        "balance": 70
      },
      "capture": {
        "wallet": "id"
      }
    },
    {
      "name": "net worth with a new EUR account",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "deactivate it",
      "method": "PATCH",
      "path": "/api/budget/accounts/{{wallet}}",
      "json": {
        "is_active": false
      }
    },
    {
      "name": "net worth ignores inactive accounts",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "off-budget brokerage with cash",
      "method": "POST",
      "path": "/api/budget/accounts",
      "json": {
        "name": "Zerodha",
        "type": "investment",
        "currency": "INR",
        "balance": 50000,
        "off_budget": true
      },
      "capture": {
        "zerodha": "id"
      }
    },
    {
      "name": "loan stored positive",
      "method": "POST",
      "path": "/api/budget/accounts",
      "json": {
        "name": "Car loan",
        "type": "loan",
        "currency": "USD",
        "balance": 4000
      }
    },
    {
      "name": "portfolio breakdown with off-budget cash",
      "method": "GET",
      "path": "/api/dashboard/portfolio-breakdown"
    },
    {
      "name": "net worth with a loan",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "dashboard for October",
      "method": "GET",
      "path": "/api/dashboard?month=2026-10"
    },
    {
      "name": "cash flow for October",
      "method": "GET",
      "path": "/api/dashboard/cash-flow?month=2026-10"
    }
  ]
}
