{
  "description": "routes/life-insurance.ts: list/get/create/update/delete with validation, days to renewal (UTC calendar days from today) and renewal alerts.",
  "steps": [
    { "name": "empty list", "method": "GET", "path": "/api/life-insurance" },
    { "name": "empty alerts", "method": "GET", "path": "/api/life-insurance/alerts" },
    { "name": "trailing slash is a 404", "method": "GET", "path": "/api/life-insurance/" },
    { "name": "get missing", "method": "GET", "path": "/api/life-insurance/missing" },
    { "name": "POST /:id is not a route", "method": "POST", "path": "/api/life-insurance/missing", "json": {} },

    { "name": "create: no body", "method": "POST", "path": "/api/life-insurance" },
    { "name": "create: invalid JSON", "method": "POST", "path": "/api/life-insurance", "body": "]" },
    { "name": "create: string body", "method": "POST", "path": "/api/life-insurance", "json": "policy" },
    { "name": "create: missing insured person", "method": "POST", "path": "/api/life-insurance", "json": { "name": "T", "provider": "LIC", "coverage_amount": 100, "renewal_date": "2027-01-01" } },
    { "name": "create: zero coverage", "method": "POST", "path": "/api/life-insurance", "json": { "name": "T", "insured_person": "A", "provider": "LIC", "coverage_amount": 0, "renewal_date": "2027-01-01" } },
    { "name": "create: Feb 29 in a common year", "method": "POST", "path": "/api/life-insurance", "json": { "name": "T", "insured_person": "A", "provider": "LIC", "coverage_amount": 100, "renewal_date": "2027-02-29" } },
    { "name": "create: non-padded date", "method": "POST", "path": "/api/life-insurance", "json": { "name": "T", "insured_person": "A", "provider": "LIC", "coverage_amount": 100, "renewal_date": "2027-1-1" } },
    { "name": "create: weekly premium", "method": "POST", "path": "/api/life-insurance", "json": { "name": "T", "insured_person": "A", "provider": "LIC", "coverage_amount": 100, "renewal_date": "2027-01-01", "premium_frequency": "weekly" } },
    { "name": "create: negative premium", "method": "POST", "path": "/api/life-insurance", "json": { "name": "T", "insured_person": "A", "provider": "LIC", "coverage_amount": 100, "renewal_date": "2027-01-01", "premium_amount": -5 } },
    { "name": "create: null currency", "method": "POST", "path": "/api/life-insurance", "json": { "name": "T", "insured_person": "A", "provider": "LIC", "coverage_amount": 100, "renewal_date": "2027-01-01", "currency": null } },
    { "name": "create: null policy number", "method": "POST", "path": "/api/life-insurance", "json": { "name": "T", "insured_person": "A", "provider": "LIC", "coverage_amount": 100, "renewal_date": "2027-01-01", "policy_number": null } },
    { "name": "still empty", "method": "GET", "path": "/api/life-insurance" },

    { "name": "create far renewal, annual premium", "method": "POST", "path": "/api/life-insurance",
      "json": { "name": "Term Far", "insured_person": "Asha", "provider": "LIC", "policy_number": "T-1", "currency": "USD", "coverage_amount": 500000, "renewal_date": "2031-07-04", "premium_amount": 1200, "premium_frequency": "annual", "extra": 1 },
      "capture": { "far": "id" } },
    { "name": "create overdue renewal, no premium", "method": "POST", "path": "/api/life-insurance",
      "json": { "name": "Term Overdue", "insured_person": "Ravi", "provider": "HDFC", "coverage_amount": 10000000, "renewal_date": "2026-01-15", "premium_amount": null, "premium_frequency": null },
      "capture": { "overdue": "id" } },
    { "name": "create soon renewal, quarterly premium", "method": "POST", "path": "/api/life-insurance",
      "json": { "name": "Group Life", "insured_person": "Asha", "provider": "Employer", "currency": "SGD", "coverage_amount": 300000, "renewal_date": "2026-12-20", "premium_amount": 45.5, "premium_frequency": "quarterly" },
      "capture": { "soon": "id" } },
    { "name": "create renewal in a month, monthly premium, frequency only", "method": "POST", "path": "/api/life-insurance",
      "json": { "name": "Frequency Only", "insured_person": "Kim", "provider": "AIA", "currency": "GBP", "coverage_amount": 1, "renewal_date": "2027-01-10", "premium_frequency": "monthly" },
      "capture": { "freq": "id" } },
    { "name": "list ordered by renewal date", "method": "GET", "path": "/api/life-insurance" },
    { "name": "get one", "method": "GET", "path": "/api/life-insurance/{{soon}}" },
    { "name": "get with an encoded id", "method": "GET", "path": "/api/life-insurance/%E2%82%AC%FF" },

    { "name": "alerts default 60 days (overdue included)", "method": "GET", "path": "/api/life-insurance/alerts" },
    { "name": "alerts 10 days", "method": "GET", "path": "/api/life-insurance/alerts?days=10" },
    { "name": "alerts 0 days via empty value", "method": "GET", "path": "/api/life-insurance/alerts?days=" },
    { "name": "alerts with a large window", "method": "GET", "path": "/api/life-insurance/alerts?days=100000" },
    { "name": "alerts very negative", "method": "GET", "path": "/api/life-insurance/alerts?days=-100000" },
    { "name": "alerts NaN", "method": "GET", "path": "/api/life-insurance/alerts?days=later" },
    { "name": "alerts with plus-encoded value", "method": "GET", "path": "/api/life-insurance/alerts?days=+45" },

    { "name": "update: invalid body beats not-found", "method": "PATCH", "path": "/api/life-insurance/missing", "json": { "coverage_amount": "lots" } },
    { "name": "update: not found", "method": "PATCH", "path": "/api/life-insurance/missing", "json": { "name": "x" } },
    { "name": "update: 'alerts' as an id", "method": "PATCH", "path": "/api/life-insurance/alerts", "json": {} },
    { "name": "update: bad renewal date", "method": "PATCH", "path": "/api/life-insurance/{{far}}", "json": { "renewal_date": "31/12/2030" } },
    { "name": "update: null name", "method": "PATCH", "path": "/api/life-insurance/{{far}}", "json": { "name": null } },
    { "name": "update: empty body only bumps updated_at", "method": "PATCH", "path": "/api/life-insurance/{{far}}", "json": {} },
    { "name": "update: clear premium and frequency", "method": "PATCH", "path": "/api/life-insurance/{{soon}}", "json": { "premium_amount": null, "premium_frequency": null } },
    { "name": "update: renewal into the alert window, new currency", "method": "PATCH", "path": "/api/life-insurance/{{far}}", "json": { "renewal_date": "2026-12-01", "currency": "INR", "coverage_amount": 7500000.25, "premium_amount": 99.5, "premium_frequency": "monthly", "insured_person": "Asha K" } },
    { "name": "list after updates", "method": "GET", "path": "/api/life-insurance" },
    { "name": "alerts after updates", "method": "GET", "path": "/api/life-insurance/alerts?days=30" },

    { "name": "delete: 'alerts' as an id", "method": "DELETE", "path": "/api/life-insurance/alerts" },
    { "name": "delete: not found", "method": "DELETE", "path": "/api/life-insurance/missing" },
    { "name": "delete", "method": "DELETE", "path": "/api/life-insurance/{{overdue}}" },
    { "name": "delete again", "method": "DELETE", "path": "/api/life-insurance/{{overdue}}" },
    { "name": "get deleted", "method": "GET", "path": "/api/life-insurance/{{overdue}}" },
    { "name": "list after delete", "method": "GET", "path": "/api/life-insurance" },
    { "name": "policies are unaffected", "method": "GET", "path": "/api/policies" }
  ]
}
