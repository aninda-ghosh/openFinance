{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DB_PATH",
    "OPENFINANCE_DB_KEY",
    "OPENFINANCE_DESKTOP",
    "JWT_SECRET",
    "ENCRYPTION_KEY",
    "OLLAMA_URL",
    "OLLAMA_MODEL",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "out/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {}
  }
}
