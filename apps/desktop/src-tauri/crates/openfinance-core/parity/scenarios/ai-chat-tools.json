{
  "description": "Singleton chat that calls every tool through the five-turn tool-calling loop (display currency USD, model override): tool texts and errors (zod error text, unknown tool, missing function/arguments, calculator errors, refresh errors offline) are compared in the tool SSE events, the /generating state and, through the fake, in the follow-up requests Node and Rust send Ollama (assistant tool_calls echoed, tool messages as JSON strings). A second chat after the 15 s retention uses an Object.prototype member as display currency.",
  "ollama": true,
  "steps": [
    { "name": "settings", "method": "GET", "path": "/api/ai/settings" },
    {
      "ollama": {
        "script": [
          { "message": { "role": "assistant", "content": "", "tool_calls": [
            { "function": { "name": "get_net_worth", "arguments": {} } },
            { "function": { "name": "get_envelope_summary", "arguments": {} } },
            { "function": { "name": "get_envelope_summary", "arguments": { "month": "2026-05" } } },
            { "function": { "name": "get_monthly_summary", "arguments": { "month": "2026-05" } } },
            { "function": { "name": "get_accounts", "arguments": {} } }
          ] } },
          { "message": { "role": "assistant", "content": "Looking at transactions", "tool_calls": [
            { "function": { "name": "get_transactions", "arguments": { "account_id": "chase-checking", "limit": 5 } } },
            { "function": { "name": "get_transactions", "arguments": { "date_from": "2026-05-01", "date_to": "2026-05-31", "limit": 3.0 } } },
            { "function": { "name": "get_transactions", "arguments": { "limit": 500, "date_from": "2026-13-01", "account_id": 7 } } },
            { "function": { "name": "get_investment_summary", "arguments": {} } },
            { "function": { "name": "get_policy_timeline", "arguments": { "years": 2 } } }
          ] } },
          { "message": { "role": "assistant", "content": null, "tool_calls": [
            { "function": { "name": "get_exchange_rates", "arguments": {} } },
            { "function": { "name": "refresh_investment_price", "arguments": { "investment_id": "nope" } } },
            { "function": { "name": "refresh_investment_price", "arguments": {} } },
            { "function": { "name": "refresh_exchange_rates", "arguments": { "currency": "usd" } } },
            { "function": { "name": "calculate", "arguments": { "expression": "3 * (120000 - 45000) / 7" } } },
            { "function": { "name": "calculate", "arguments": { "expression": "1 / (2 - 2)" } } },
            { "function": { "name": "calculate", "arguments": { "expression": "Math.sqrt(4)" } } },
            { "function": { "name": "calculate", "arguments": {} } }
          ] } },
          { "message": { "role": "assistant", "content": "", "tool_calls": [
            { "function": { "name": "not_a_tool", "arguments": { "x": 1.5 } } },
            { "id": "call_1" },
            { "function": { "name": "get_net_worth" } },
            { "function": { "name": "get_envelope_summary" } },
            { "function": { "arguments": { "month": "2026-04" } } }
          ] } },
          { "message": { "role": "assistant", "content": "", "tool_calls": [
            { "function": { "name": "get_policy_timeline", "arguments": { "years": null } } },
            { "function": { "name": "get_policy_timeline", "arguments": { "years": 0 } } },
            { "function": { "name": "calculate", "arguments": { "expression": 12.5 } } }
          ] } },
          { "stream": [
            { "message": { "role": "assistant", "content": "Your net worth is " } },
            { "message": { "role": "assistant", "content": "healthy." } },
            { "done": true }
          ] }
        ]
      }
    },
    { "name": "start chat", "method": "GET", "path": "/api/ai/chat?message=How%20am%20I%20doing%3F&currency=USD&model=custom%3A7b" },
    { "name": "wait until done", "method": "GET", "path": "/api/ai/generating", "poll": { "until": "state.isDone", "equals": true } },
    { "name": "re-attach: tokens, every tool event, done", "method": "GET", "path": "/api/ai/chat" },
    { "name": "requests (6 turns)", "ollama": { "requests": true, "count": 6 } },
    { "name": "messages", "method": "GET", "path": "/api/ai/messages" },
    { "name": "audit stays empty", "method": "GET", "path": "/api/ai/conversations/__singleton__/audit" },
    { "sleepMs": 15500 },
    {
      "ollama": {
        "script": [
          { "message": { "role": "assistant", "content": "", "tool_calls": [
            { "function": { "name": "get_net_worth", "arguments": {} } },
            { "function": { "name": "get_accounts", "arguments": {} } },
            { "function": { "name": "calculate", "arguments": { "expression": "2+2" } } }
          ] } },
          { "message": { "role": "assistant", "content": "" } },
          { "stream": [ { "message": { "content": "ok" }, "done": true } ] }
        ]
      }
    },
    { "name": "chat with currency=toString", "method": "GET", "path": "/api/ai/chat?message=again&currency=toString" },
    { "name": "wait", "method": "GET", "path": "/api/ai/generating", "poll": { "until": "state.isDone", "equals": true } },
    { "name": "replay", "method": "GET", "path": "/api/ai/chat" },
    { "name": "requests (history now has 4 messages)", "ollama": { "requests": true, "count": 3 } },
    { "name": "memory", "memoryFiles": true }
  ]
}
