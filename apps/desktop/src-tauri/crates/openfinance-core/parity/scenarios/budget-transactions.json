{
  "description": "routes/budget.ts transactions: list filters and pagination (with filter validation), create (envelope rule, filing into the right month, dedupe 409), update (re-filing, transfers, 404, validation), transfers (from savings, on→off budget, cross-currency, dedupe), delete (pair delete), with balance / envelope reads after mutations.",
  "steps": [
    { "name": "list default", "method": "GET", "path": "/api/budget/transactions" },
    { "name": "list page 2 limit 5", "method": "GET", "path": "/api/budget/transactions?page=2&limit=5" },
    { "name": "list page past the end", "method": "GET", "path": "/api/budget/transactions?page=99&limit=5" },
    { "name": "list by account", "method": "GET", "path": "/api/budget/transactions?account_id=chase-checking" },
    { "name": "list by envelope", "method": "GET", "path": "/api/budget/transactions?envelope_id=env-2026-05-13" },
    { "name": "list by type", "method": "GET", "path": "/api/budget/transactions?type=transfer" },
    { "name": "list by date range", "method": "GET", "path": "/api/budget/transactions?date_from=2026-05-10&date_to=2026-05-20" },
    { "name": "list search", "method": "GET", "path": "/api/budget/transactions?search=foods" },
    { "name": "list search with plus", "method": "GET", "path": "/api/budget/transactions?search=whole+foods" },
    { "name": "list search wildcard chars", "method": "GET", "path": "/api/budget/transactions?search=%25" },
    { "name": "list off_budget true", "method": "GET", "path": "/api/budget/transactions?off_budget=true" },
    { "name": "list off_budget false", "method": "GET", "path": "/api/budget/transactions?off_budget=false" },
    { "name": "list off_budget other", "method": "GET", "path": "/api/budget/transactions?off_budget=yes" },
    { "name": "list empty account filter", "method": "GET", "path": "/api/budget/transactions?account_id=&type=expense" },
    { "name": "filters: bad type", "method": "GET", "path": "/api/budget/transactions?type=refund" },
    { "name": "filters: bad date", "method": "GET", "path": "/api/budget/transactions?date_from=2026-02-30" },
    { "name": "filters: limit too big", "method": "GET", "path": "/api/budget/transactions?limit=201" },
    { "name": "filters: limit 200", "method": "GET", "path": "/api/budget/transactions?limit=200" },
    { "name": "filters: page 0", "method": "GET", "path": "/api/budget/transactions?page=0" },
    { "name": "filters: fractional page", "method": "GET", "path": "/api/budget/transactions?page=1.5" },
    { "name": "filters: page abc", "method": "GET", "path": "/api/budget/transactions?page=abc" },
    { "name": "filters: empty page", "method": "GET", "path": "/api/budget/transactions?page=" },
    { "name": "filters: page with spaces", "method": "GET", "path": "/api/budget/transactions?page=%202%20&limit=3" },
    { "name": "filters: hex limit", "method": "GET", "path": "/api/budget/transactions?limit=0x3" },

    { "name": "create: validation", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "chase-checking", "payee": "", "amount": 0, "type": "transfer", "date": "2026/05/01" } },
    { "name": "create: string amount", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "chase-checking", "payee": "X", "amount": "5", "type": "income", "date": "2026-05-01" } },
    { "name": "create: invalid JSON", "method": "POST", "path": "/api/budget/transactions", "body": "{\"a\":" },
    { "name": "create: on-budget expense needs an envelope", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "chase-checking", "payee": "Shop", "amount": 10, "type": "expense", "date": "2026-05-11" } },
    { "name": "create: unknown account", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "nope", "payee": "Shop", "amount": 10, "type": "expense", "date": "2026-05-11" } },
    { "name": "create: unknown account income (FK)", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "nope", "payee": "Shop", "amount": 10, "type": "income", "date": "2026-05-11" } },
    { "name": "create: off-budget expense without envelope", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "ally-hysa", "payee": "Fee", "amount": 3.25, "type": "expense", "date": "2026-05-03" } },
    { "name": "create expense in May", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "chase-checking", "envelope_id": "env-2026-05-13", "payee": "Costco", "amount": 210.33, "type": "expense", "date": "2026-05-04", "notes": "bulk", "import_hash": "h-1" }, "capture": { "costco": "id" } },
    { "name": "create: duplicate import hash", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "chase-checking", "envelope_id": "env-2026-05-13", "payee": "Costco", "amount": 210.33, "type": "expense", "date": "2026-05-04", "import_hash": "h-1" } },
    { "name": "create expense filed into June", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "chase-checking", "envelope_id": "env-2026-05-13", "payee": "Safeway", "amount": 40, "type": "expense", "date": "2026-06-06" }, "capture": { "safeway": "id" } },
    { "name": "create expense filed into a new month", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "hdfc-checking-inr", "envelope_id": "env-2026-05-17", "payee": "Chai", "amount": 150, "type": "expense", "date": "2026-10-02" } },
    { "name": "create expense filed into an old month", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "hdfc-checking-inr", "envelope_id": "env-2026-05-17", "payee": "Old chai", "amount": 90, "type": "expense", "date": "2025-12-30" } },
    { "name": "create: unknown envelope", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "chase-checking", "envelope_id": "nope", "payee": "X", "amount": 1, "type": "expense", "date": "2026-05-04" } },
    { "name": "create income with category", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "chase-checking", "payee": "Card cashback", "amount": 12.5, "type": "income", "date": "2026-05-06", "income_category": "cashback" }, "capture": { "cashback": "id" } },
    { "name": "create income without category", "method": "POST", "path": "/api/budget/transactions", "json": { "account_id": "hdfc-checking-inr", "payee": "Refund", "amount": 500, "type": "income", "date": "2026-05-07" } },
    { "name": "June envelopes after filing", "method": "GET", "path": "/api/budget/envelopes?month=2026-06" },
    { "name": "October envelopes after filing", "method": "GET", "path": "/api/budget/envelopes?month=2026-10" },
    { "name": "December 2025 envelopes", "method": "GET", "path": "/api/budget/envelopes?month=2025-12" },
    { "name": "accounts after creates", "method": "GET", "path": "/api/budget/accounts" },

    { "name": "update: validation", "method": "PATCH", "path": "/api/budget/transactions/{{costco}}", "json": { "amount": -1, "type": "transfer" } },
    { "name": "update: unknown", "method": "PATCH", "path": "/api/budget/transactions/nope", "json": { "notes": "x" } },
    { "name": "update: empty body", "method": "PATCH", "path": "/api/budget/transactions/{{costco}}", "json": {} },
    { "name": "update: amount and notes", "method": "PATCH", "path": "/api/budget/transactions/{{costco}}", "json": { "amount": 199.99, "notes": "fixed" } },
    { "name": "update: move to July refiles envelope", "method": "PATCH", "path": "/api/budget/transactions/{{costco}}", "json": { "date": "2026-07-09" } },
    { "name": "update: clear envelope on on-budget expense", "method": "PATCH", "path": "/api/budget/transactions/{{costco}}", "json": { "envelope_id": null } },
    { "name": "update: switch to income clears nothing", "method": "PATCH", "path": "/api/budget/transactions/{{safeway}}", "json": { "type": "income", "income_category": null, "payee": "Safeway refund" } },
    { "name": "update: income back to expense without envelope", "method": "PATCH", "path": "/api/budget/transactions/{{cashback}}", "json": { "type": "expense" } },
    { "name": "update: income category", "method": "PATCH", "path": "/api/budget/transactions/{{cashback}}", "json": { "income_category": "starting_balance" } },
    { "name": "update: envelope to unknown", "method": "PATCH", "path": "/api/budget/transactions/{{costco}}", "json": { "envelope_id": "nope" } },
    { "name": "July envelopes after updates", "method": "GET", "path": "/api/budget/envelopes?month=2026-07" },

    { "name": "transfer: validation", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "", "to_account_id": "ally-hysa", "amount": "abc", "date": "x" } },
    { "name": "transfer: string amounts coerce", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "chase-checking", "to_account_id": "amex-gold", "amount": "75.5", "date": "2026-05-27", "notes": "card payment" }, "capture": { "cardpay": "from.id" } },
    { "name": "transfer: same account", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "policy-acc-hdfc", "to_account_id": "policy-acc-hdfc", "amount": 1, "date": "2026-05-27" } },
    { "name": "transfer: unknown account", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "nope", "to_account_id": "chase-checking", "amount": 1, "date": "2026-05-27" } },
    { "name": "transfer: on to off budget needs envelope", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "chase-checking", "to_account_id": "fidelity-brokerage", "amount": 100, "date": "2026-05-28" } },
    { "name": "transfer: on to off budget with envelope", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "chase-checking", "to_account_id": "fidelity-brokerage", "amount": 100, "date": "2026-05-28", "envelope_id": "env-2026-05-20", "import_hash": "t-1" } },
    { "name": "transfer: duplicate hash", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "chase-checking", "to_account_id": "fidelity-brokerage", "amount": 100, "date": "2026-05-28", "envelope_id": "env-2026-05-20", "import_hash": "t-1" } },
    { "name": "transfer: from savings", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "ally-hysa", "to_account_id": "chase-checking", "amount": 250, "date": "2026-05-29", "from_savings": true }, "capture": { "fromsav": "to.id" } },
    { "name": "transfer: from savings from an on-budget account", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "hdfc-checking-inr", "to_account_id": "chase-checking", "amount": 250, "date": "2026-05-29", "from_savings": true } },
    { "name": "transfer: cross currency", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "hdfc-checking-inr", "to_account_id": "chase-checking", "amount": 8300, "to_amount": "100", "date": "2026-06-02", "to_envelope_id": "env-2026-05-19" } },
    { "name": "transfer: with to_envelope into new month", "method": "POST", "path": "/api/budget/transactions/transfer", "json": { "from_account_id": "fidelity-brokerage", "to_account_id": "chase-checking", "amount": 20, "date": "2026-08-03", "to_envelope_id": "env-2026-05-19", "envelope_id": "env-2026-05-20" } },
    { "name": "transfer GET is a 404", "method": "GET", "path": "/api/budget/transactions/transfer" },
    { "name": "transfers listed", "method": "GET", "path": "/api/budget/transactions?type=transfer&account_id=chase-checking" },
    { "name": "summary May after transfers", "method": "GET", "path": "/api/budget/reports/summary?month=2026-05" },
    { "name": "summary June after transfers", "method": "GET", "path": "/api/budget/reports/summary?month=2026-06" },
    { "name": "accounts after transfers", "method": "GET", "path": "/api/budget/accounts" },

    { "name": "update transfer leg: amount is ignored", "method": "PATCH", "path": "/api/budget/transactions/{{cardpay}}", "json": { "amount": 9999, "notes": "paid" } },
    { "name": "update transfer leg: new date moves both legs", "method": "PATCH", "path": "/api/budget/transactions/{{cardpay}}", "json": { "date": "2026-06-01" } },
    { "name": "amex transfers after update", "method": "GET", "path": "/api/budget/transactions?account_id=amex-gold&type=transfer" },
    { "name": "PATCH /transactions/transfer falls through", "method": "PATCH", "path": "/api/budget/transactions/transfer", "json": { "notes": "x" } },
    { "name": "DELETE /transactions/bulk falls through", "method": "DELETE", "path": "/api/budget/transactions/bulk" },

    { "name": "delete one transfer leg deletes the pair", "method": "DELETE", "path": "/api/budget/transactions/{{fromsav}}" },
    { "name": "delete again", "method": "DELETE", "path": "/api/budget/transactions/{{fromsav}}" },
    { "name": "delete expense", "method": "DELETE", "path": "/api/budget/transactions/{{costco}}" },
    { "name": "delete seeded transfer leg", "method": "DELETE", "path": "/api/budget/transactions/txn-transfer-cc-in" },
    { "name": "chase after deletes", "method": "GET", "path": "/api/budget/transactions?account_id=chase-checking&limit=100" },
    { "name": "accounts after deletes", "method": "GET", "path": "/api/budget/accounts" },
    { "name": "May envelopes at the end", "method": "GET", "path": "/api/budget/envelopes?month=2026-05" }
  ]
}
