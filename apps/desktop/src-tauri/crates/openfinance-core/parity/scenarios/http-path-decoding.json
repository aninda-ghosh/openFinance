{
  "description": "Hono routes on the decodeURI'd path (getPath: tryDecodeURI with %25 protected): escaped route literals reach their routes, reserved escapes (%2F) and %25 stay encoded, undecodable escapes are kept, and params are still decoded once by the handlers (Wave 4).",
  "steps": [
    { "name": "escaped /health", "method": "GET", "path": "/%68ealth" },
    { "name": "escaped /health, lowercase hex, HEAD", "method": "HEAD", "path": "/%68%65alth" },
    { "name": "escaped /health, forbidden origin", "method": "GET", "path": "/%68ealth", "headers": { "Origin": "https://evil.example" } },
    { "name": "escaped /health, allowed origin", "method": "GET", "path": "/%68ealth", "headers": { "Origin": "tauri://localhost" } },
    { "name": "policies timeline", "method": "GET", "path": "/api/policies/%74imeline" },
    { "name": "policies alerts", "method": "GET", "path": "/api/policies/%61lerts" },
    { "name": "escaped prefix segment", "method": "GET", "path": "/%61pi/policies/alerts" },
    { "name": "PATCH escaped literal goes to :id", "method": "PATCH", "path": "/api/policies/%74imeline", "json": { "name": "x" } },
    { "name": "policies timeline with escaped slash is not the timeline", "method": "GET", "path": "/api/policies/%74imeline%2F" },
    { "name": "life insurance alerts", "method": "GET", "path": "/api/life-insurance/%61lerts" },
    { "name": "life insurance :id with a decoded euro sign", "method": "GET", "path": "/api/life-insurance/%E2%82%AC" },
    { "name": "budget accounts", "method": "GET", "path": "/api/budget/%61ccounts" },
    { "name": "budget accounts, query kept", "method": "GET", "path": "/api/budget/%61ccounts?x=%61&y=%2F" },
    {
      "name": "create through an escaped path",
      "method": "POST",
      "path": "/api/budget/%61ccounts",
      "json": { "name": "Escaped", "type": "checking", "currency": "INR" },
      "capture": { "acc": "account.id" }
    },
    { "name": "patch through an escaped path", "method": "PATCH", "path": "/api/budget/%61ccounts/{{acc}}", "json": { "name": "Escaped 2" } },
    { "name": "read back", "method": "GET", "path": "/api/budget/accounts" },
    { "name": "delete through an escaped path", "method": "DELETE", "path": "/api/budget/%61ccount%73/{{acc}}" },
    { "name": "read back after delete", "method": "GET", "path": "/api/budget/accounts" },
    { "name": "envelope trends, param %2574 decodes once to %74", "method": "GET", "path": "/api/budget/reports/envelope-trends/%2574" },
    { "name": "envelope trends, param is a space", "method": "GET", "path": "/api/budget/reports/envelope-trends/%20" },
    { "name": "envelope trends, valid then invalid escapes", "method": "GET", "path": "/api/budget/reports/envelope-trends/%C3%A9x%E9" },
    { "name": "envelope trends, escaped literal and param", "method": "GET", "path": "/api/budget/reports/%65nvelope-trends/%C3%A9" },
    { "name": "dashboard net worth", "method": "GET", "path": "/api/dashboard/%6Eet-worth" },
    { "name": "dashboard net worth history, escaped query", "method": "GET", "path": "/api/dashboard/%6Eet-worth-history?months=%33" },
    { "name": "exchange rates base currency", "method": "GET", "path": "/api/exchange-rates/%62ase-currency" },
    { "name": "investments portfolio summary", "method": "GET", "path": "/api/investments/%70ortfolio-summary" },
    { "name": "ai settings", "method": "GET", "path": "/api/ai/%73ettings" },
    { "name": "documents :docId", "method": "GET", "path": "/api/documents/%64oc-missing" },
    { "name": "backup routes", "method": "POST", "path": "/api/%62ackup/import", "body": "not a zip" },
    { "name": "reset transactions, wrong method", "method": "GET", "path": "/api/reset/%74ransactions" },
    { "name": "escaped slash stays a slash escape", "method": "GET", "path": "/api/budget%2Faccounts" },
    { "name": "trailing escaped slash", "method": "GET", "path": "/api/budget/accounts%2F" },
    { "name": "%25 is protected", "method": "GET", "path": "/api/%2562udget/accounts" },
    { "name": "undecodable escape", "method": "GET", "path": "/api/budget/%E9" },
    { "name": "malformed escape", "method": "GET", "path": "/api/budget/%6" },
    { "name": "overlong encoding", "method": "GET", "path": "/api/budget/%C1%A1ccounts" },
    { "name": "encoded dot segments are not resolved", "method": "GET", "path": "/api/budget/%2E%2E/budget/accounts" }
  ]
}
