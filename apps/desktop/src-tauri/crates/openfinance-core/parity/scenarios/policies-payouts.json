{
  "description": "routes/policies.ts payouts: add/update/mark-received (including the cross-policy quirks), generate with unvalidated input, and how payouts show up in the timeline.",
  "steps": [
    { "name": "create policy A", "method": "POST", "path": "/api/policies",
      "json": { "name": "Payout A", "provider": "LIC", "start_date": "2020-01-31", "premium_amount": 1000, "premium_frequency": "annual", "premium_term_years": 5, "policy_term_years": 20, "maturity_date": "2040-01-31", "sum_assured": 100000, "maturity_value": 150000 },
      "capture": { "a": "id" } },
    { "name": "create policy B", "method": "POST", "path": "/api/policies",
      "json": { "name": "Payout B", "provider": "SBI", "currency": "SGD", "start_date": "2025-06-15", "premium_amount": 300, "premium_frequency": "quarterly", "premium_term_years": 1, "policy_term_years": 2, "maturity_date": "2027-06-15", "sum_assured": 5000, "maturity_value": 5500 },
      "capture": { "b": "id" } },

    { "name": "payouts of a new policy", "method": "GET", "path": "/api/policies/{{a}}/payouts" },
    { "name": "payouts of a missing policy (empty, no 404)", "method": "GET", "path": "/api/policies/missing/payouts" },

    { "name": "add: no body", "method": "POST", "path": "/api/policies/{{a}}/payouts" },
    { "name": "add: bad date", "method": "POST", "path": "/api/policies/{{a}}/payouts", "json": { "payout_date": "2026-02-29", "amount": 10, "label": "x" } },
    { "name": "add: zero amount", "method": "POST", "path": "/api/policies/{{a}}/payouts", "json": { "payout_date": "2026-02-28", "amount": 0, "label": "x" } },
    { "name": "add: empty label", "method": "POST", "path": "/api/policies/{{a}}/payouts", "json": { "payout_date": "2026-02-28", "amount": 10, "label": "" } },
    { "name": "add: string is_received", "method": "POST", "path": "/api/policies/{{a}}/payouts", "json": { "payout_date": "2026-02-28", "amount": 10, "label": "x", "is_received": "true" } },
    { "name": "add: missing policy (foreign key, 500)", "method": "POST", "path": "/api/policies/missing/payouts", "json": { "payout_date": "2026-02-28", "amount": 10, "label": "x" } },
    { "name": "add payout 1", "method": "POST", "path": "/api/policies/{{a}}/payouts", "json": { "payout_date": "2030-01-31", "amount": 25000, "label": "Survival benefit", "policy_id": "ignored" }, "capture": { "p1": "id" } },
    { "name": "add payout 2 (received)", "method": "POST", "path": "/api/policies/{{a}}/payouts", "json": { "payout_date": "2025-01-31", "amount": 12500.5, "label": "Bonus", "is_received": true }, "capture": { "p2": "id" } },
    { "name": "add payout 3 (same date as 1)", "method": "POST", "path": "/api/policies/{{a}}/payouts", "json": { "payout_date": "2030-01-31", "amount": 1, "label": "Same day" }, "capture": { "p3": "id" } },
    { "name": "add payout to B", "method": "POST", "path": "/api/policies/{{b}}/payouts", "json": { "payout_date": "2026-12-15", "amount": 50, "label": "B payout" }, "capture": { "pb": "id" } },
    { "name": "payouts sorted by date", "method": "GET", "path": "/api/policies/{{a}}/payouts" },

    { "name": "update payout: empty body (drizzle: no values to set)", "method": "PATCH", "path": "/api/policies/{{a}}/payouts/{{p1}}", "json": {} },
    { "name": "update payout: invalid", "method": "PATCH", "path": "/api/policies/{{a}}/payouts/{{p1}}", "json": { "amount": -1 } },
    { "name": "update payout: invalid JSON", "method": "PATCH", "path": "/api/policies/{{a}}/payouts/{{p1}}", "body": "x" },
    { "name": "update payout: missing payout", "method": "PATCH", "path": "/api/policies/{{a}}/payouts/missing", "json": { "label": "y" } },
    { "name": "update payout", "method": "PATCH", "path": "/api/policies/{{a}}/payouts/{{p1}}", "json": { "amount": 30000, "label": "Survival benefit (revised)", "is_received": false } },
    { "name": "update payout through the wrong policy: 404 but applied", "method": "PATCH", "path": "/api/policies/{{b}}/payouts/{{p3}}", "json": { "label": "changed via B" } },
    { "name": "update payout with a literal 'generate' id", "method": "PATCH", "path": "/api/policies/{{a}}/payouts/generate", "json": { "label": "z" } },
    { "name": "mark received", "method": "POST", "path": "/api/policies/{{a}}/payouts/{{p1}}/mark-received" },
    { "name": "mark received again", "method": "POST", "path": "/api/policies/{{a}}/payouts/{{p1}}/mark-received", "body": "ignored" },
    { "name": "mark received through the wrong policy: 404 but applied", "method": "POST", "path": "/api/policies/{{a}}/payouts/{{pb}}/mark-received" },
    { "name": "mark received: missing payout", "method": "POST", "path": "/api/policies/{{a}}/payouts/missing/mark-received" },
    { "name": "GET mark-received is a 404", "method": "GET", "path": "/api/policies/{{a}}/payouts/{{p1}}/mark-received" },
    { "name": "A payouts after updates", "method": "GET", "path": "/api/policies/{{a}}/payouts" },
    { "name": "B payouts after updates", "method": "GET", "path": "/api/policies/{{b}}/payouts" },

    { "name": "generate: no body", "method": "POST", "path": "/api/policies/{{a}}/payouts/generate" },
    { "name": "generate: missing label", "method": "POST", "path": "/api/policies/{{a}}/payouts/generate", "json": { "start_date": "2026-01-31", "end_date": "2026-06-30", "amount": 10, "frequency": "monthly" } },
    { "name": "generate: zero amount", "method": "POST", "path": "/api/policies/{{a}}/payouts/generate", "json": { "start_date": "2026-01-31", "end_date": "2026-06-30", "amount": 0, "frequency": "monthly", "label": "x" } },
    { "name": "generate: array body", "method": "POST", "path": "/api/policies/{{a}}/payouts/generate", "json": ["x"] },
    { "name": "generate: missing policy", "method": "POST", "path": "/api/policies/missing/payouts/generate", "json": { "start_date": "2026-01-31", "end_date": "2026-06-30", "amount": 10, "frequency": "monthly", "label": "x" } },
    { "name": "generate: numeric start date (TypeError)", "method": "POST", "path": "/api/policies/{{a}}/payouts/generate", "json": { "start_date": 20260131, "end_date": "2026-06-30", "amount": 10, "frequency": "monthly", "label": "x" } },
    { "name": "generate: numeric end date (TypeError)", "method": "POST", "path": "/api/policies/{{a}}/payouts/generate", "json": { "start_date": "2026-01-31", "end_date": 20260630, "amount": 10, "frequency": "monthly", "label": "x" } },
    { "name": "generate: boolean amount (cannot bind)", "method": "POST", "path": "/api/policies/{{a}}/payouts/generate", "json": { "start_date": "2026-01-31", "end_date": "2026-06-30", "amount": true, "frequency": "monthly", "label": "x" } },
    { "name": "generate: object label (cannot bind)", "method": "POST", "path": "/api/policies/{{a}}/payouts/generate", "json": { "start_date": "2026-01-31", "end_date": "2026-06-30", "amount": 10, "frequency": "monthly", "label": { "a": 1 } } },
    { "name": "generate: end before start creates nothing", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "2026-01-31", "end_date": "2025-12-31", "amount": true, "frequency": "monthly", "label": "x" } },
    { "name": "generate monthly on the 31st", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "2026-01-31", "end_date": "2026-06-30T23:59:59Z", "amount": 75.25, "frequency": "monthly", "label": "Monthly income" } },
    { "name": "generate quarterly, string amount and numeric label", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "2026-11-30", "end_date": "2027-08-31", "amount": "99.5", "frequency": "quarterly", "label": 7 } },
    { "name": "generate unknown frequency (annual), array end date", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "2028-02-29", "end_date": ["2031-03-01", null], "amount": [42], "frequency": "weekly", "label": ["Yearly"] } },
    { "name": "generate with amount/label spread by better-sqlite3", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "2032-05-05", "end_date": "2032-05-05", "amount": [], "frequency": "annual", "label": ["shifted", "label"] } },
    { "name": "generate with too many spread values", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "2032-05-05", "end_date": "2032-05-05", "amount": [1, 2], "frequency": "annual", "label": "x" } },
    { "name": "generate with a non-numeric amount", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "2033-01-01", "end_date": "2033-01-01", "amount": "lots", "frequency": "monthly", "label": "text amount" } },
    { "name": "generate without a day (NaN days)", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "2026-02", "end_date": "2026-04", "amount": 1, "frequency": "monthly", "label": "no day" } },
    { "name": "generate with a 3-digit year", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "999-01-15", "end_date": "999-06-30", "amount": 1, "frequency": "quarterly", "label": "year 999" } },
    { "name": "generate with a 5-digit year", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "12345-01-01", "end_date": "12346", "amount": 1, "frequency": "quarterly", "label": "far future" } },
    { "name": "generate with garbage start (stops at once)", "method": "POST", "path": "/api/policies/{{b}}/payouts/generate", "json": { "start_date": "garbage", "end_date": "2030", "amount": 1, "frequency": "monthly", "label": "x" } },
    { "name": "B payouts after generate", "method": "GET", "path": "/api/policies/{{b}}/payouts" },

    { "name": "policies list includes payouts", "method": "GET", "path": "/api/policies" },
    { "name": "timeline 5 years with payouts", "method": "GET", "path": "/api/policies/timeline" },
    { "name": "timeline 20000 years (5-digit payout years)", "method": "GET", "path": "/api/policies/timeline?years=20000" },
    { "name": "timeline -2000 years", "method": "GET", "path": "/api/policies/timeline?years=-2000" },
    { "name": "alerts", "method": "GET", "path": "/api/policies/alerts?days=365" },

    { "name": "delete B with its payouts", "method": "DELETE", "path": "/api/policies/{{b}}" },
    { "name": "B payouts are gone", "method": "GET", "path": "/api/policies/{{b}}/payouts" },
    { "name": "timeline after delete", "method": "GET", "path": "/api/policies/timeline?years=10" }
  ]
}
