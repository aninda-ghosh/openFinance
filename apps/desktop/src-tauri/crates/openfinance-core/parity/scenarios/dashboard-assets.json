    {
      "name": "unlinking with an empty account id fails the foreign key (500)",
      "method": "PATCH",
      "path": "/api/policies/{{pol}}",
      "json": {
        "account_id": ""
      }
    },
    {
      "name": "deactivate the policy's account",
      "method": "PATCH",
      "path": "/api/budget/accounts/{{polacc}}",
      "json": {
        "is_active": false
      }
    },
    {
      "name": "net worth: policy without an active account valued at premiums paid",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "a policy-type account with no policy row",
      "method": "POST",
      "path": "/api/budget/accounts",
      "json": {
        "name": "Old endowment",
        "type": "policy",
        "currency": "GBP",
        "balance": 900,
        "off_budget": true
      }
    },
    {
      "name": "net worth: the orphan policy account still counts",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "history after unlinking",
      "method": "GET",
      "path": "/api/dashboard/net-worth-history?months=3"
    },
    {
      "name": "dashboard after unlinking",
      "method": "GET",
      "path": "/api/dashboard?month=2026-11"
    },
    {
      "name": "link the second policy to a cash account",
      "method": "PATCH",
      "path": "/api/policies/{{pol2}}",
      "json": {
        "account_id": "hdfc-checking-inr"
      }
    },
    {
      "name": "net worth: that account is now a policy, not cash",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "life insurance entry",
      "method": "POST",
      "path": "/api/life-insurance",
      "json": {
        "name": "Term cover",
        "insured_person": "Self",
        "provider": "HDFC Life",
        "coverage_amount": 10000000,
        "renewal_date": "2026-12-15",
        "premium_amount": 12000
      }
    },
    {
      "name": "dashboard is unaffected by life insurance",
      "method": "GET",
      "path": "/api/dashboard?month=2026-11"
    },
    {
      "name": "net worth is unaffected by life insurance",
      "method": "GET",
      "path": "/api/dashboard/net-worth"
    },
    {
      "name": "delete the second policy",
      "method": "DELETE",
      "path": "/api/policies/{{pol2}}"
    },
    {
      "name": "dashboard after deleting a policy",
      "method": "GET",
      "path": "/api/dashboard?month=2026-11"
    },
    {
      "name": "delete an investment",
