{
  "description": "routes/budget.ts accounts: list with derived balances, create (starting balance seeding, liabilities, validation), update (rename, reconciliation, 404, validation), delete (cascade, 404) and reads of transactions/balances after each mutation.",
  "steps": [
    { "name": "list seeded accounts", "method": "GET", "path": "/api/budget/accounts" },
    { "name": "trailing slash is a 404", "method": "GET", "path": "/api/budget/accounts/" },
    { "name": "wrong method on collection", "method": "DELETE", "path": "/api/budget/accounts" },
    { "name": "GET one account is a 404", "method": "GET", "path": "/api/budget/accounts/chase-checking" },

    { "name": "create: invalid JSON", "method": "POST", "path": "/api/budget/accounts", "body": "{oops" },
    { "name": "create: empty body", "method": "POST", "path": "/api/budget/accounts" },
    { "name": "create: missing name and type", "method": "POST", "path": "/api/budget/accounts", "json": {} },
    { "name": "create: empty name", "method": "POST", "path": "/api/budget/accounts", "json": { "name": "", "type": "checking" } },
    { "name": "create: bad type", "method": "POST", "path": "/api/budget/accounts", "json": { "name": "X", "type": "brokerage" } },
    { "name": "create: bad currency", "method": "POST", "path": "/api/budget/accounts", "json": { "name": "X", "type": "cash", "currency": "usd" } },
    { "name": "create: string balance", "method": "POST", "path": "/api/budget/accounts", "json": { "name": "X", "type": "cash", "balance": "10" } },
    { "name": "create: string off_budget", "method": "POST", "path": "/api/budget/accounts", "json": { "name": "X", "type": "cash", "off_budget": "true" } },
    { "name": "create: array body", "method": "POST", "path": "/api/budget/accounts", "json": [{ "name": "X", "type": "cash" }] },

    { "name": "create cash with opening balance", "method": "POST", "path": "/api/budget/accounts", "json": { "name": "Wallet", "type": "cash", "currency": "SGD", "balance": 250.75, "institution": "Me", "extra": 1 }, "capture": { "wallet": "id" } },
    { "name": "create off-budget savings with balance", "method": "POST", "path": "/api/budget/accounts", "json": { "name": "Vault", "type": "savings", "balance": 1000, "off_budget": true }, "capture": { "vault": "id" } },
    { "name": "create credit card with debt", "method": "POST", "path": "/api/budget/accounts", "json": { "name": "Visa", "type": "credit", "currency": "USD", "balance": 300 }, "capture": { "visa": "id" } },
    { "name": "create loan with negative balance", "method": "POST", "path": "/api/budget/accounts", "json": { "name": "Car Loan", "type": "loan", "currency": "EUR", "balance": -5000 }, "capture": { "loan": "id" } },
    { "name": "create checking with zero balance", "method": "POST", "path": "/api/budget/accounts", "json": { "name": "Empty", "type": "checking" }, "capture": { "empty": "id" } },
    { "name": "list after creates", "method": "GET", "path": "/api/budget/accounts" },
    { "name": "wallet starting balance transaction", "method": "GET", "path": "/api/budget/transactions?account_id={{wallet}}" },
    { "name": "vault has no starting balance transaction", "method": "GET", "path": "/api/budget/transactions?account_id={{vault}}" },
    { "name": "visa has no starting balance transaction", "method": "GET", "path": "/api/budget/transactions?account_id={{visa}}" },

    { "name": "update: validation", "method": "PATCH", "path": "/api/budget/accounts/{{wallet}}", "json": { "name": "", "balance": "x", "is_active": 1 } },
    { "name": "update: invalid JSON", "method": "PATCH", "path": "/api/budget/accounts/{{wallet}}", "body": "nope" },
    { "name": "update: unknown account", "method": "PATCH", "path": "/api/budget/accounts/nope", "json": { "name": "Ghost" } },
    { "name": "update: empty patch", "method": "PATCH", "path": "/api/budget/accounts/{{wallet}}", "json": {} },
    { "name": "update: rename only", "method": "PATCH", "path": "/api/budget/accounts/{{wallet}}", "json": { "name": "Pocket", "institution": "Self" } },
    { "name": "update: same balance writes nothing", "method": "PATCH", "path": "/api/budget/accounts/{{wallet}}", "json": { "balance": 250.75 } },
    { "name": "update: reconcile upwards", "method": "PATCH", "path": "/api/budget/accounts/{{wallet}}", "json": { "balance": 300.1 } },
    { "name": "update: reconcile downwards", "method": "PATCH", "path": "/api/budget/accounts/{{wallet}}", "json": { "balance": 99.999 } },
    { "name": "wallet adjustments", "method": "GET", "path": "/api/budget/transactions?account_id={{wallet}}" },
    { "name": "update: reconcile credit card", "method": "PATCH", "path": "/api/budget/accounts/{{visa}}", "json": { "balance": -120 } },
    { "name": "update: credit card positive balance", "method": "PATCH", "path": "/api/budget/accounts/{{visa}}", "json": { "balance": 50 } },
    { "name": "visa adjustments", "method": "GET", "path": "/api/budget/transactions?account_id={{visa}}" },
    { "name": "update: deactivate and move off budget", "method": "PATCH", "path": "/api/budget/accounts/{{empty}}", "json": { "is_active": false, "off_budget": true, "currency": "GBP", "type": "savings" } },
    { "name": "update: seeded checking reconcile", "method": "PATCH", "path": "/api/budget/accounts/chase-checking", "json": { "balance": 3000 } },
    { "name": "update: seeded INR account", "method": "PATCH", "path": "/api/budget/accounts/hdfc-checking-inr", "json": { "balance": 120000.5, "name": "HDFC" } },
    { "name": "list after updates", "method": "GET", "path": "/api/budget/accounts" },

    { "name": "delete: unknown account", "method": "DELETE", "path": "/api/budget/accounts/nope" },
    { "name": "delete wallet", "method": "DELETE", "path": "/api/budget/accounts/{{wallet}}" },
    { "name": "delete wallet again", "method": "DELETE", "path": "/api/budget/accounts/{{wallet}}" },
    { "name": "wallet transactions gone", "method": "GET", "path": "/api/budget/transactions?account_id={{wallet}}" },
    { "name": "delete amex (recurring rule and transfer legs)", "method": "DELETE", "path": "/api/budget/accounts/amex-gold" },
    { "name": "recurring after amex delete", "method": "GET", "path": "/api/budget/recurring" },
    { "name": "chase transactions keep the orphaned leg", "method": "GET", "path": "/api/budget/transactions?account_id=chase-checking" },
    { "name": "list after deletes", "method": "GET", "path": "/api/budget/accounts" },
    { "name": "percent-encoded id", "method": "PATCH", "path": "/api/budget/accounts/ally%2Dhysa", "json": { "name": "Ally" } },
    { "name": "final list", "method": "GET", "path": "/api/budget/accounts" }
  ]
}
