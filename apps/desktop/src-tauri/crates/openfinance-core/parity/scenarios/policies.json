{
  "description": "routes/policies.ts: list/create/update/delete with validation, companion accounts, linked-account live balances, timeline and alerts relative to today.",
  "steps": [
    { "name": "list seeded policy (linked account)", "method": "GET", "path": "/api/policies" },
    { "name": "trailing slash is a 404", "method": "GET", "path": "/api/policies/" },
    { "name": "GET /:id is not a route", "method": "GET", "path": "/api/policies/policy-hdfc" },
    { "name": "PUT is not a route", "method": "PUT", "path": "/api/policies/policy-hdfc", "json": {} },

    { "name": "create: no body", "method": "POST", "path": "/api/policies" },
    { "name": "create: invalid JSON", "method": "POST", "path": "/api/policies", "body": "{nope" },
    { "name": "create: null body", "method": "POST", "path": "/api/policies", "body": "null" },
    { "name": "create: array body", "method": "POST", "path": "/api/policies", "json": [] },
    { "name": "create: empty object", "method": "POST", "path": "/api/policies", "json": {} },
    { "name": "create: empty name", "method": "POST", "path": "/api/policies", "json": { "name": "", "provider": "LIC", "start_date": "2025-01-31", "premium_amount": 100, "premium_frequency": "monthly", "premium_term_years": 2, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000 } },
    { "name": "create: unsupported currency", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "currency": "AUD", "start_date": "2025-01-31", "premium_amount": 100, "premium_frequency": "monthly", "premium_term_years": 2, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000 } },
    { "name": "create: null currency", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "currency": null, "start_date": "2025-01-31", "premium_amount": 100, "premium_frequency": "monthly", "premium_term_years": 2, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000 } },
    { "name": "create: Feb 30 start", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "start_date": "2025-02-30", "premium_amount": 100, "premium_frequency": "monthly", "premium_term_years": 2, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000 } },
    { "name": "create: datetime start", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "start_date": "2025-01-31T00:00:00Z", "premium_amount": 100, "premium_frequency": "monthly", "premium_term_years": 2, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000 } },
    { "name": "create: zero premium", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "start_date": "2025-01-31", "premium_amount": 0, "premium_frequency": "monthly", "premium_term_years": 2, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000 } },
    { "name": "create: fractional term", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "start_date": "2025-01-31", "premium_amount": 100, "premium_frequency": "monthly", "premium_term_years": 2.5, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000 } },
    { "name": "create: string term", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "start_date": "2025-01-31", "premium_amount": 100, "premium_frequency": "monthly", "premium_term_years": "2", "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000 } },
    { "name": "create: unsafe integer term", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "start_date": "2025-01-31", "premium_amount": 100, "premium_frequency": "monthly", "premium_term_years": 9007199254740992, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000 } },
    { "name": "create: weekly frequency", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "start_date": "2025-01-31", "premium_amount": 100, "premium_frequency": "weekly", "premium_term_years": 2, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000 } },
    { "name": "create: negative surrender value", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "start_date": "2025-01-31", "premium_amount": 100, "premium_frequency": "monthly", "premium_term_years": 2, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000, "surrender_value": -1 } },
    { "name": "create: numeric notes", "method": "POST", "path": "/api/policies", "json": { "name": "P", "provider": "LIC", "start_date": "2025-01-31", "premium_amount": 100, "premium_frequency": "monthly", "premium_term_years": 2, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 1000, "maturity_value": 2000, "notes": 5 } },
    { "name": "nothing was created", "method": "GET", "path": "/api/policies" },

    { "name": "create monthly USD policy on the 31st", "method": "POST", "path": "/api/policies",
      "json": { "name": "Zeta Monthly", "provider": "MetLife", "policy_number": "ML-1", "currency": "USD", "start_date": "2025-01-31", "premium_amount": 250.75, "premium_frequency": "monthly", "premium_term_years": 2, "policy_term_years": 5, "maturity_date": "2030-01-31", "sum_assured": 50000, "maturity_value": 60000, "surrender_value": null, "notes": "end of month", "account_id": "ignored-account", "extra": "stripped" },
      "capture": { "zeta": "id", "zetaAcc": "account_id" } },
    { "name": "create quarterly policy, default currency", "method": "POST", "path": "/api/policies",
      "json": { "name": "Alpha Quarterly", "provider": "LIC", "start_date": "2024-11-30", "premium_amount": 5000, "premium_frequency": "quarterly", "premium_term_years": 3, "policy_term_years": 10, "maturity_date": "2034-11-30", "sum_assured": 200000, "maturity_value": 250000, "surrender_value": 12000.5 },
      "capture": { "alpha": "id", "alphaAcc": "account_id" } },
    { "name": "create annual JPY policy starting on a leap day", "method": "POST", "path": "/api/policies",
      "json": { "name": "Mid Annual", "provider": "Nippon", "currency": "JPY", "start_date": "2024-02-29", "premium_amount": 120000, "premium_frequency": "annual", "premium_term_years": 5, "policy_term_years": 1, "maturity_date": "2025-02-28", "sum_assured": 1000000, "maturity_value": 1100000, "surrender_value": 0 },
      "capture": { "mid": "id" } },
    { "name": "create policy starting in the future", "method": "POST", "path": "/api/policies",
      "json": { "name": "Beta Future", "provider": "HDFC", "currency": "NTD", "start_date": "2027-03-15", "premium_amount": 1000, "premium_frequency": "monthly", "premium_term_years": 1, "policy_term_years": 1, "maturity_date": "2099-12-31", "sum_assured": 5000, "maturity_value": 6000 },
      "capture": { "beta": "id" } },
    { "name": "list: ordered by name, new accounts start at 0", "method": "GET", "path": "/api/policies" },

    { "name": "update: invalid body beats not-found", "method": "PATCH", "path": "/api/policies/missing", "json": { "premium_amount": -5 } },
    { "name": "update: not found", "method": "PATCH", "path": "/api/policies/missing", "json": { "name": "x" } },
    { "name": "update: invalid JSON", "method": "PATCH", "path": "/api/policies/{{zeta}}", "body": "{" },
    { "name": "update: empty name", "method": "PATCH", "path": "/api/policies/{{zeta}}", "json": { "name": "" } },
    { "name": "update: bad maturity date", "method": "PATCH", "path": "/api/policies/{{zeta}}", "json": { "maturity_date": "2030-04-31" } },
    { "name": "update: null name", "method": "PATCH", "path": "/api/policies/{{zeta}}", "json": { "name": null } },
    { "name": "update: empty body syncs account balance", "method": "PATCH", "path": "/api/policies/{{zeta}}", "json": {} },
    { "name": "update: rename and change currency", "method": "PATCH", "path": "/api/policies/{{alpha}}", "json": { "name": "Alpha Renamed", "provider": "LIC India", "currency": "GBP", "surrender_value": null, "notes": "" } },
    { "name": "update: start date and term", "method": "PATCH", "path": "/api/policies/{{mid}}", "json": { "start_date": "2023-08-31", "premium_term_years": 3, "premium_frequency": "quarterly", "premium_amount": 30000.5 } },
    { "name": "update: literal 'timeline' id", "method": "PATCH", "path": "/api/policies/timeline", "json": { "name": "x" } },
    { "name": "update: literal 'alerts' id", "method": "PATCH", "path": "/api/policies/alerts", "json": {} },
    { "name": "update: encoded id", "method": "PATCH", "path": "/api/policies/a%20b%2Fc", "json": {} },
    { "name": "update: malformed escape in id", "method": "PATCH", "path": "/api/policies/%E2%82%AC%ZZ%FF", "json": {} },
    { "name": "list after updates (account balances synced)", "method": "GET", "path": "/api/policies" },

    { "name": "link a policy to an account with transactions", "method": "PATCH", "path": "/api/policies/{{beta}}", "json": { "account_id": "chase-checking" } },
    { "name": "link to a missing account (FK)", "method": "PATCH", "path": "/api/policies/{{mid}}", "json": { "account_id": "no-such-account" } },
    { "name": "list with the linked live balance", "method": "GET", "path": "/api/policies" },
    { "name": "exchange rates unchanged", "method": "GET", "path": "/api/exchange-rates" },

    { "name": "timeline, default 5 years", "method": "GET", "path": "/api/policies/timeline" },
    { "name": "timeline, 0 years", "method": "GET", "path": "/api/policies/timeline?years=0" },
    { "name": "timeline, empty years", "method": "GET", "path": "/api/policies/timeline?years=" },
    { "name": "timeline, years without value", "method": "GET", "path": "/api/policies/timeline?years" },
    { "name": "timeline, 1.5 years", "method": "GET", "path": "/api/policies/timeline?years=1.5" },
    { "name": "timeline, 20 years", "method": "GET", "path": "/api/policies/timeline?years=20" },
    { "name": "timeline, 100 years", "method": "GET", "path": "/api/policies/timeline?years=100" },
    { "name": "timeline, negative years", "method": "GET", "path": "/api/policies/timeline?years=-3" },
    { "name": "timeline, NaN years (premiums only)", "method": "GET", "path": "/api/policies/timeline?years=abc" },
    { "name": "timeline, encoded years", "method": "GET", "path": "/api/policies/timeline?x=1&years=%31%30" },
    { "name": "timeline, hex years", "method": "GET", "path": "/api/policies/timeline?years=0x3" },
    { "name": "timeline, huge years (invalid cutoff)", "method": "GET", "path": "/api/policies/timeline?years=1e9" },

    { "name": "alerts, default 30 days", "method": "GET", "path": "/api/policies/alerts" },
    { "name": "alerts, 60 days", "method": "GET", "path": "/api/policies/alerts?days=60" },
    { "name": "alerts, 400 days", "method": "GET", "path": "/api/policies/alerts?days=400" },
    { "name": "alerts, negative", "method": "GET", "path": "/api/policies/alerts?days=-1" },
    { "name": "alerts, NaN", "method": "GET", "path": "/api/policies/alerts?days=soon" },
    { "name": "alerts, Infinity", "method": "GET", "path": "/api/policies/alerts?days=Infinity" },
    { "name": "POST alerts is a 404", "method": "POST", "path": "/api/policies/alerts" },

    { "name": "delete: literal 'timeline' id", "method": "DELETE", "path": "/api/policies/timeline" },
    { "name": "delete: not found", "method": "DELETE", "path": "/api/policies/missing" },
    { "name": "delete a policy and its account", "method": "DELETE", "path": "/api/policies/{{zeta}}" },
    { "name": "delete again", "method": "DELETE", "path": "/api/policies/{{zeta}}" },
    { "name": "update the deleted policy", "method": "PATCH", "path": "/api/policies/{{zeta}}", "json": { "name": "back" } },
    { "name": "delete the seeded policy", "method": "DELETE", "path": "/api/policies/policy-hdfc" },
    { "name": "delete linked policy: account has transactions (500 after the policy is gone)", "method": "DELETE", "path": "/api/policies/{{beta}}" },
    { "name": "list after deletes", "method": "GET", "path": "/api/policies" },
    { "name": "timeline after deletes", "method": "GET", "path": "/api/policies/timeline?years=50" }
  ]
}
