{
  "description": "routes/budget.ts recurring rules and maintenance: list, create (validation, envelope rule), update (anchor day, empty patch 500, 404), apply-due catch-up into envelopes, delete, the static apply-due path falling through to /recurring/:id, and the misfiled-transaction report / repair.",
  "steps": [
    { "name": "list seeded rules", "method": "GET", "path": "/api/budget/recurring" },
    { "name": "apply-due with nothing due", "method": "POST", "path": "/api/budget/recurring/apply-due" },
    { "name": "apply-due GET is a 404", "method": "GET", "path": "/api/budget/recurring/apply-due" },

    { "name": "create: validation", "method": "POST", "path": "/api/budget/recurring", "json": { "payee": "", "amount": 0, "type": "transfer", "account_id": "chase-checking", "frequency": "daily", "next_date": "2026-13-01" } },
    { "name": "create: bad end date", "method": "POST", "path": "/api/budget/recurring", "json": { "payee": "Gym", "amount": 30, "type": "income", "account_id": "chase-checking", "frequency": "monthly", "next_date": "2026-12-01", "end_date": "soon" } },
    { "name": "create: invalid JSON", "method": "POST", "path": "/api/budget/recurring", "body": "{" },
    { "name": "create: on-budget expense needs an envelope", "method": "POST", "path": "/api/budget/recurring", "json": { "payee": "Gym", "amount": 30, "type": "expense", "account_id": "chase-checking", "frequency": "monthly", "next_date": "2026-12-01" } },
    { "name": "create: unknown account expense", "method": "POST", "path": "/api/budget/recurring", "json": { "payee": "Gym", "amount": 30, "type": "expense", "account_id": "nope", "frequency": "monthly", "next_date": "2026-12-01" } },
    { "name": "create: unknown account income (FK)", "method": "POST", "path": "/api/budget/recurring", "json": { "payee": "Gym", "amount": 30, "type": "income", "account_id": "nope", "frequency": "monthly", "next_date": "2026-12-01" } },
    { "name": "create monthly rent on the 31st, overdue", "method": "POST", "path": "/api/budget/recurring", "json": { "payee": "Rent", "amount": 1200, "type": "expense", "account_id": "chase-checking", "envelope_id": "env-2026-05-12", "frequency": "monthly", "next_date": "2026-07-31", "notes": "lease" }, "capture": { "rent": "id" } },
    { "name": "create weekly income with end date", "method": "POST", "path": "/api/budget/recurring", "json": { "payee": "Tutoring", "amount": 45.5, "type": "income", "account_id": "hdfc-checking-inr", "frequency": "weekly", "next_date": "2026-10-20", "end_date": "2026-11-05", "notes": null }, "capture": { "tutor": "id" } },
    { "name": "create quarterly off-budget expense", "method": "POST", "path": "/api/budget/recurring", "json": { "payee": "Fee", "amount": 9, "type": "expense", "account_id": "ally-hysa", "frequency": "quarterly", "next_date": "2027-01-15", "envelope_id": null }, "capture": { "fee": "id" } },
    { "name": "create annual rule a year overdue", "method": "POST", "path": "/api/budget/recurring", "json": { "payee": "Insurance", "amount": 300, "type": "expense", "account_id": "chase-checking", "envelope_id": "env-2026-05-22", "frequency": "annual", "next_date": "2025-11-30" }, "capture": { "ins": "id" } },
    { "name": "list after creates", "method": "GET", "path": "/api/budget/recurring" },

    { "name": "update: empty patch is a 500", "method": "PATCH", "path": "/api/budget/recurring/{{fee}}", "json": {} },
    { "name": "update: validation", "method": "PATCH", "path": "/api/budget/recurring/{{fee}}", "json": { "is_active": "no" } },
    { "name": "update: unknown", "method": "PATCH", "path": "/api/budget/recurring/nope", "json": { "amount": 1 } },
    { "name": "update: next date sets anchor", "method": "PATCH", "path": "/api/budget/recurring/{{fee}}", "json": { "next_date": "2027-01-29", "amount": 10 } },
    { "name": "update: make it on-budget expense without envelope", "method": "PATCH", "path": "/api/budget/recurring/{{fee}}", "json": { "account_id": "chase-checking" } },
    { "name": "update: deactivate", "method": "PATCH", "path": "/api/budget/recurring/{{fee}}", "json": { "is_active": false, "end_date": null } },
    { "name": "update: PATCH apply-due falls through", "method": "PATCH", "path": "/api/budget/recurring/apply-due", "json": { "amount": 1 } },
    { "name": "delete: DELETE apply-due falls through", "method": "DELETE", "path": "/api/budget/recurring/apply-due" },

    { "name": "deleting a category a rule uses fails (recurring FK, 500)", "method": "DELETE", "path": "/api/budget/envelopes/env-2026-05-22" },
    { "name": "apply-due catches up", "method": "POST", "path": "/api/budget/recurring/apply-due" },
    { "name": "apply-due again", "method": "POST", "path": "/api/budget/recurring/apply-due" },
    { "name": "rules after apply", "method": "GET", "path": "/api/budget/recurring" },
    { "name": "rent transactions", "method": "GET", "path": "/api/budget/transactions?search=Rent&account_id=chase-checking" },
    { "name": "tutoring transactions", "method": "GET", "path": "/api/budget/transactions?account_id=hdfc-checking-inr&type=income" },
    { "name": "insurance transactions", "method": "GET", "path": "/api/budget/transactions?search=Insurance" },
    { "name": "August envelopes", "method": "GET", "path": "/api/budget/envelopes?month=2026-08" },
    { "name": "November envelopes", "method": "GET", "path": "/api/budget/envelopes?month=2026-11" },

    { "name": "delete rule", "method": "DELETE", "path": "/api/budget/recurring/{{rent}}" },
    { "name": "delete rule again", "method": "DELETE", "path": "/api/budget/recurring/{{rent}}" },
    { "name": "final rules", "method": "GET", "path": "/api/budget/recurring" },

    { "name": "misfiled report", "method": "GET", "path": "/api/budget/maintenance/misfiled" },
    { "name": "misfiled repair", "method": "POST", "path": "/api/budget/maintenance/misfiled/repair" },
    { "name": "misfiled repair GET is a 404", "method": "GET", "path": "/api/budget/maintenance/misfiled/repair" },
    { "name": "misfiled POST is a 404", "method": "POST", "path": "/api/budget/maintenance/misfiled" }
  ]
}
