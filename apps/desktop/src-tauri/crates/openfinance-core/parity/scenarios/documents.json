{
  "description": "routes/documents.ts: list (seed has no documents), not-found paths and every upload rejection. A successful upload is not compared here: its disk name doc_<nanoid(12)><ext> is random and appears in the response (see STATUS.md; covered by tests/compat_backup.rs). Uploads that fail after writing the file come last.",
  "steps": [
    {
      "name": "list (empty)",
      "method": "GET",
      "path": "/api/documents"
    },
    {
      "name": "list with filters",
      "method": "GET",
      "path": "/api/documents?investment_id=inv-aapl&account_id=x&life_insurance_id=y"
    },
    {
      "name": "trailing slash",
      "method": "GET",
      "path": "/api/documents/"
    },
    {
      "name": "get unknown",
      "method": "GET",
      "path": "/api/documents/unknown"
    },
    {
      "name": "delete unknown",
      "method": "DELETE",
      "path": "/api/documents/unknown"
    },
    {
      "name": "put not allowed",
      "method": "PUT",
      "path": "/api/documents/x"
    },
    {
      "name": "upload without body",
      "method": "POST",
      "path": "/api/documents"
    },
    {
      "name": "upload JSON",
      "method": "POST",
      "path": "/api/documents",
      "json": {
        "file": "x"
      }
    },
    {
      "name": "upload urlencoded",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "body": "file=abc&name=x"
    },
    {
      "name": "upload multipart without file",
      "method": "POST",
      "path": "/api/documents",
      "multipart": {
        "fields": {
          "name": "x",
          "investment_id": "inv-aapl"
        }
      }
    },
    {
      "name": "upload file field as text",
      "method": "POST",
      "path": "/api/documents",
      "multipart": {
        "fields": {
          "file": "not a file"
        }
      }
    },
    {
      "name": "file under file[] key",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file[]\"; filename=\"a.txt\"\r\n\r\nx\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "missing boundary",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data"
      },
      "body": "x"
    },
    {
      "name": "boundary not in body",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "nothing here"
    },
    {
      "name": "not form-data disposition",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: attachment; name=\"file\"; filename=\"a\"\r\n\r\nx\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "no name attribute",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; filename=\"a\"\r\n\r\nx\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "bad header name",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nBad Header: x\r\n\r\nx\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "unclosed quote",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file; filename=\"a\"\r\n\r\nx\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "bad extended filename",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file\"; filename*=latin1''a\r\n\r\nx\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "malformed percent in filename*",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file\"; filename*=UTF-8''%E2\r\n\r\nx\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "missing CRLF after boundary",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdefX\r\n"
    },
    {
      "name": "no closing boundary",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a\"\r\n\r\nx\r\n"
    },
    {
      "name": "multipart-ish content type",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data-x; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a\"\r\n\r\nx\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "fk violation after writing the file",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF\r\n------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"investment_id\"\r\n\r\nno-such-investment\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "name sent as a file",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.pdf\"\r\n\r\n%PDF\r\n------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"name\"; filename=\"n.txt\"\r\n\r\nx\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "notes sent as a file",
      "method": "POST",
      "path": "/api/documents",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=----parityBoundary0123456789abcdef"
      },
      "body": "------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.pdf\"\r\n\r\n%PDF\r\n------parityBoundary0123456789abcdef\r\nContent-Disposition: form-data; name=\"notes\"; filename=\"n.txt\"\r\n\r\nx\r\n------parityBoundary0123456789abcdef--\r\n"
    },
    {
      "name": "no rows were added",
      "method": "GET",
      "path": "/api/documents"
    }
  ]
}
